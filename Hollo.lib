    TextDim = Color3.fromRGB(160, 160, 160),
    Outline = Color3.fromRGB(45, 45, 50),
    Border = Color3.fromRGB(30, 30, 35),
    Section = Color3.fromRGB(22, 22, 26),
    Element = Color3.fromRGB(34, 34, 38),
