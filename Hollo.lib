-- ============================================================
-- UNLOAD
-- ============================================================

function Library:Unload()
    for _, c in pairs(self.Connections) do c.Connection:Disconnect() end
    for _, t in pairs(self.Threads) do coroutine.close(t) end
    if self.Holder then self.Holder:Clean() end
    Library = nil; getgenv().Library = nil
end

