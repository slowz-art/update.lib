Library.FadeSpeed = 0.2

-- ============================================================
-- TWEEN & INSTANCE WRAPPER
-- ============================================================

local Tween = {}
Tween.__index = Tween

function Tween:Create(item, info, goal, raw)
    item = raw and item or item.Instance
    info = info or TweenInfo.new(Library.TweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local t = TweenService:Create(item, info, goal)
    t:Play()
    return setmetatable({ Tween = t, Item = item }, Tween)
end

function Tween:GetProperty(item)
    if item:IsA("Frame") then return { "BackgroundTransparency" }
    elseif item:IsA("TextLabel") or item:IsA("TextButton") then return { "TextTransparency", "BackgroundTransparency" }
    elseif item:IsA("ImageLabel") or item:IsA("ImageButton") then return { "BackgroundTransparency", "ImageTransparency" }
    elseif item:IsA("ScrollingFrame") then return { "BackgroundTransparency", "ScrollBarImageTransparency" }
    elseif item:IsA("TextBox") then return { "TextTransparency", "BackgroundTransparency" }
    elseif item:IsA("UIStroke") then return { "Transparency" }
    end
    return {}
end

function Tween:Fade(item, prop, vis, speed)
    local old = item[prop]
    item[prop] = vis and 1 or old
    local t = Tween:Create(item, TweenInfo.new(speed or Library.FadeSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        [prop] = vis and old or 1
    }, true)
    t.Tween.Completed:Connect(function()
        if not vis then task.wait(); item[prop] = old end
    end)
    return t
end

-- ============================================================
-- INSTANCES WRAPPER
-- ============================================================

local Inst = {}
Inst.__index = Inst

function Inst:Create(class, props)
    local obj = Instance.new(class)
    for k,v in pairs(props) do obj[k] = v end
    return setmetatable({ Instance = obj, Properties = props, Class = class }, Inst)
end

function Inst:AddToTheme(props)
    if not self.Instance then return end
    Library:AddToTheme(self, props)
end

function Inst:ChangeItemTheme(props)
    if not self.Instance then return end
    Library:ChangeItemTheme(self, props)
end

function Inst:Connect(event, cb, name)
    if not self.Instance or not self.Instance[event] then return end
    if IsMobile then
        if event == "MouseButton1Down" or event == "MouseButton1Click" then event = "TouchTap"
        elseif event == "MouseButton2Down" or event == "MouseButton2Click" then event = "TouchLongPress" end
    end
    return Library:Connect(self.Instance[event], cb, name)
end

function Inst:Tween(info, goal)
    if not self.Instance then return end
    return Tween:Create(self, info, goal)
end

function Inst:Clean()
    if self.Instance then self.Instance:Destroy() end
    self = nil
end

function Inst:MakeDraggable()
    if not self.Instance then return end
    local gui = self.Instance
    local dragging, dragStart, startPos
    local function set(input)
        local delta = input.Position - dragStart
        local x = MathClamp(startPos.X.Offset + delta.X, 0, gui.Parent.AbsoluteSize.X - gui.AbsoluteSize.X)
        local y = MathClamp(startPos.Y.Offset + delta.Y, 0, gui.Parent.AbsoluteSize.Y - gui.AbsoluteSize.Y)
        self:Tween(TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2New(0,x,0,y) })
    end
    self:Connect("InputBegan", function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = inp.Position; startPos = gui.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    Library:Connect(UserInputService.InputChanged, function(inp)
        if (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) and dragging then
            set(inp)
        end
    end)
end

function Inst:MakeResizeable(min, max)
    if not self.Instance then return end
    local gui = self.Instance
    local resizing, side, startMouse, startPos, startSize
    local edge = 2
    local edges = {
        { Inst:Create("TextButton", { Size = UDim2New(0,edge,1,0), Position = UDim2New(0,0,0,0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 99999, Parent = gui }), "L" },
        { Inst:Create("TextButton", { Size = UDim2New(0,edge,1,0), Position = UDim2New(1,-edge,0,0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 99999, Parent = gui }), "R" },
        { Inst:Create("TextButton", { Size = UDim2New(1,0,0,edge), Position = UDim2New(0,0,0,0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 99999, Parent = gui }), "T" },
        { Inst:Create("TextButton", { Size = UDim2New(1,0,0,edge), Position = UDim2New(0,0,1,-edge), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 99999, Parent = gui }), "B" },
    }
    for _, e in pairs(edges) do
        e[1]:Connect("InputBegan", function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = true; side = e[2]; startMouse = UserInputService:GetMouseLocation()
                startPos = Vector2New(gui.Position.X.Offset, gui.Position.Y.Offset)
                startSize = Vector2New(gui.Size.X.Offset, gui.Size.Y.Offset)
            end
        end)
    end
    Library:Connect(UserInputService.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 and resizing then resizing = false end
    end)
    Library:Connect(RunService.RenderStepped, function()
        if not resizing or not side then return end
        local m = UserInputService:GetMouseLocation()
        local dx, dy = m.X - startMouse.X, m.Y - startMouse.Y
        local x,y,w,h = startPos.X, startPos.Y, startSize.X, startSize.Y
        if side == "L" then x = startPos.X + dx; w = startSize.X - dx
        elseif side == "R" then w = startSize.X + dx
        elseif side == "T" then y = startPos.Y + dy; h = startSize.Y - dy
        elseif side == "B" then h = startSize.Y + dy end
        if w < min.X then if side == "L" then x = x - (min.X - w) end; w = min.X end
        if h < min.Y then if side == "T" then y = y - (min.Y - h) end; h = min.Y end
        self:Tween(TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2New(0,x,0,y) })
        self:Tween(TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2New(0,w,0,h) })
    end)
end

-- ============================================================
-- LIBRARY METHODS
-- ============================================================

function Library:AddToTheme(item, props)
    item = item.Instance or item
    local data = { Item = item, Properties = props }
    for k,v in pairs(props) do
        if type(v) == "string" then item[k] = self.Theme[v]
        else item[k] = v() end
    end
    TableInsert(self.ThemeItems, data)
    self.ThemeMap[item] = data
end

function Library:ChangeItemTheme(item, props)
    item = item.Instance or item
    local data = self.ThemeMap[item]
    if not data then return end
    data.Properties = props
    for k,v in pairs(props) do
        if type(v) == "string" then item[k] = self.Theme[v]
        else item[k] = v() end
    end
end

function Library:ChangeTheme(key, color)
    self.Theme[key] = color
    for _, data in pairs(self.ThemeItems) do
        for k,v in pairs(data.Properties) do
            if type(v) == "string" and v == key then data.Item[k] = color end
        end
    end
end

function Library:Connect(event, cb, name)
    name = name or ("conn_" .. tostring(#self.Connections+1) .. "_" .. HttpService:GenerateGUID(false))
    local conn = { Event = event, Callback = cb, Name = name, Connection = nil }
    self:Thread(function() conn.Connection = event:Connect(cb) end)
    TableInsert(self.Connections, conn)
    return conn
end

function Library:Thread(func)
    local t = coroutine.create(func)
    coroutine.wrap(function() coroutine.resume(t) end)()
    TableInsert(self.Threads, t)
    return t
end

function Library:SafeCall(func, ...)
    local ok, err = pcall(func, ...)
    if not ok then warn(err) end
    return ok
end

function Library:Round(n, decimals)
    local mult = 10^(decimals or 0)
    return MathFloor(n * mult + 0.5) / mult
end

function Library:IsMouseOverFrame(frame)
    frame = frame.Instance or frame
    local p = Vector2New(Mouse.X, Mouse.Y)
    local a = frame.AbsolutePosition
    local s = frame.AbsoluteSize
    return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

function Library:GetConfig()
    local cfg = {}
    for k,v in pairs(self.Flags) do
        if type(v) == "table" and v.Key then cfg[k] = { Key = tostring(v.Key), Mode = v.Mode }
        elseif type(v) == "table" and v.Color then cfg[k] = { Color = "#" .. v.HexValue, Alpha = v.Alpha }
        else cfg[k] = v end
    end
    return HttpService:JSONEncode(cfg)
end

function Library:LoadConfig(cfg)
    local data = HttpService:JSONDecode(cfg)
    for k,v in pairs(data) do
        local set = self.SetFlags[k]
        if set then
            if type(v) == "table" and v.Key then set(v)
            elseif type(v) == "table" and v.Color then set(v.Color, v.Alpha)
            else set(v) end
        end
    end
end

function Library:DeleteConfig(name)
    if isfile(self.Folders.Configs .. "/" .. name) then delfile(self.Folders.Configs .. "/" .. name) end
end

function Library:RefreshConfigsList(dropdown)
    local list = {}
    for _, file in pairs(listfiles(self.Folders.Configs)) do
        local name = file:match("([^/\\]+)%.json$")
        if name then TableInsert(list, name) end
    end
    dropdown:Refresh(list)
end

function Library:NextFlag()
    return "flag_" .. tostring(#self.Flags+1) .. "_" .. HttpService:GenerateGUID(false)
end

-- ============================================================
-- BLUR EFFECT
-- ============================================================

function Library:MakeBlurred(item, window)
    item = item.Instance
    local part = Inst:Create("Part", {
        Material = Enum.Material.Glass,
        Transparency = 1,
        Reflectance = 1,
        CastShadow = false,
        Anchored = true,
        CanCollide = false,
        Size = Vector3New(1,1,1)*0.01,
        Color = Color3.new(0,0,0),
        Parent = Camera
    })
    local mesh = Inst:Create("BlockMesh", { Parent = part.Instance })
    local dof = Inst:Create("DepthOfFieldEffect", {
        Parent = Lighting,
        Enabled = true,
        FarIntensity = 0,
        FocusDistance = 0,
        InFocusRadius = 1000,
        NearIntensity = 0,
        Name = ""
    })
    self:Connect(RunService.RenderStepped, function()
        if window.IsOpen and item.Visible then
            dof.Instance.NearIntensity = 1
            part.Instance.Transparency = 0.97
            part.Instance.Size = Vector3New(1,1,1)*0.01
            local c0 = item.AbsolutePosition
            local c1 = c0 + item.AbsoluteSize
            local r0 = Camera:ScreenPointToRay(c0.X, c0.Y, 1)
            local r1 = Camera:ScreenPointToRay(c1.X, c1.Y, 1)
            local origin = Camera.CFrame.Position + Camera.CFrame.LookVector * (0.05 - Camera.NearPlaneZ)
            local normal = Camera.CFrame.LookVector
            local function get(pos)
                local n = normal; local d = r0.Direction; local v = pos - origin
                local num = n.x*v.x + n.y*v.y + n.z*v.z
                local den = n.x*d.x + n.y*d.y + n.z*d.z
                local a = -num/den
                return origin + a*d
            end
            local p0 = get(r0.Origin)
            local p1 = get(r1.Origin)
            p0 = Camera.CFrame:PointToObjectSpace(p0)
            p1 = Camera.CFrame:PointToObjectSpace(p1)
            local size = p1 - p0
            local center = (p0 + p1) / 2
            mesh.Instance.Offset = center
            mesh.Instance.Scale = size / 0.0101
            part.Instance.CFrame = Camera.CFrame
        else
            dof.Instance.NearIntensity = 0
            mesh.Instance.Offset = Vector3New(0,0,0)
            mesh.Instance.Scale = Vector3New(0,0,0)
        end
    end)
end

