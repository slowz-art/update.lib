Library.Window = function(self, Data)
    Data = Data or {}
    local Window = {
        Name = Data.Name or "Window",
        SubName = Data.SubName or "",
        Logo = Data.Logo or "1234567890",
        Pages = {},
        Items = {},
        IsOpen = false,
        CurrentAlignment = "LeftTabs"
    }

    local Items = {}
    -- Main Frame – tall & narrow (420x720)
    Items["MainFrame"] = Inst:Create("Frame", {
        Parent = Library.Holder.Instance,
        Name = "\0",
        AnchorPoint = Vector2New(0.5,0.5),
        BackgroundTransparency = 0.15,
        Position = UDim2New(0.5,0,0.5,0),
        Size = UDim2New(0,420,0,720),
        ZIndex = 2,
        BorderSizePixel = 0,
    })
    Items["MainFrame"]:AddToTheme({ BackgroundColor3 = "Background" })
    Items["MainFrame"]:MakeResizeable(Vector2New(380,500), Vector2New(9999,9999))
    Library:MakeBlurred(Items["MainFrame"], Window)

    -- Left Tabs – narrower (180)
    Items["LeftTabs"] = Inst:Create("Frame", {
        Parent = Items["MainFrame"].Instance,
        Name = "\0",
        AnchorPoint = Vector2New(1,0),
        BackgroundTransparency = 0.15,
        Size = UDim2New(0,180,1,0),
        ZIndex = 2,
        BorderSizePixel = 0,
    })
    Items["LeftTabs"]:AddToTheme({ BackgroundColor3 = "Background" })
    Library:MakeBlurred(Items["LeftTabs"], Window)

    -- Title
    Items["Title"] = Inst:Create("TextLabel", {
        Parent = Items["MainFrame"].Instance,
        Font = Library.Font,
        TextSize = 16,
        Text = Window.Name,
        Position = UDim2New(0,52,0,13),
        Size = UDim2New(0,0,0,15),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
    })
    Items["Title"]:AddToTheme({ TextColor3 = "Text" })

    Items["SubTitle"] = Inst:Create("TextLabel", {
        Parent = Items["MainFrame"].Instance,
        Font = Library.Font,
        TextSize = 14,
        Text = Window.SubName,
        Position = UDim2New(0,52,0,30),
        Size = UDim2New(0,0,0,15),
        BackgroundTransparency = 1,
        TextTransparency = 0.4,
        AutomaticSize = Enum.AutomaticSize.X,
    })
    Items["SubTitle"]:AddToTheme({ TextColor3 = "Text" })

    -- Logo
    Items["Logo"] = Inst:Create("ImageLabel", {
        Parent = Items["MainFrame"].Instance,
        Image = "rbxassetid://" .. Window.Logo,
        Size = UDim2New(0,35,0,35),
        Position = UDim2New(0,12,0,12),
        BackgroundTransparency = 1,
    })

    -- Content area
    Items["Content"] = Inst:Create("Frame", {
        Parent = Items["MainFrame"].Instance,
        Name = "\0",
        BackgroundTransparency = 0.75,
        Position = UDim2New(0,0,0,55),
        Size = UDim2New(1,0,1,-55),
        ZIndex = 2,
        BorderSizePixel = 0,
    })
    Items["Content"]:AddToTheme({ BackgroundColor3 = "Background" })

    -- Close button
    Items["CloseButton"] = Inst:Create("TextButton", {
        Parent = Items["MainFrame"].Instance,
        Text = "",
        AutoButtonColor = false,
        AnchorPoint = Vector2New(1,0),
        Position = UDim2New(1,-14,0,11),
        Size = UDim2New(0,32,0,32),
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
    })
    Items["CloseButton"]:AddToTheme({ BackgroundColor3 = "Element" })
    Inst:Create("UICorner", { Parent = Items["CloseButton"].Instance, CornerRadius = UDimNew(0,7) })
    Items["CloseButton"]:Connect("MouseButton1Down", function() Library:Unload() end)

    -- Settings button
    Items["SettingsButton"] = Inst:Create("TextButton", {
        Parent = Items["MainFrame"].Instance,
        Text = "",
        AutoButtonColor = false,
        AnchorPoint = Vector2New(1,0),
        Position = UDim2New(1,-56,0,11),
        Size = UDim2New(0,32,0,32),
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
    })
    Items["SettingsButton"]:AddToTheme({ BackgroundColor3 = "Element" })
    Inst:Create("UICorner", { Parent = Items["SettingsButton"].Instance, CornerRadius = UDimNew(0,7) })

    -- Tab container (UIListLayout in LeftTabs)
    Inst:Create("UIListLayout", {
        Parent = Items["LeftTabs"].Instance,
        Padding = UDimNew(0,12),
        SortOrder = Enum.SortOrder.LayoutOrder
    })
    Inst:Create("UIPadding", {
        Parent = Items["LeftTabs"].Instance,
        PaddingTop = UDimNew(0,15),
        PaddingBottom = UDimNew(0,15),
        PaddingRight = UDimNew(0,12),
        PaddingLeft = UDimNew(0,12)
    })

    Window.Items = Items

    -- Drag functionality on the whole window (already implemented via Inst:MakeDraggable on MainFrame)
    Items["MainFrame"]:MakeDraggable()

    -- ===== WINDOW METHODS =====
    function Window:SetOpen(bool)
        -- Fade in/out
        Window.IsOpen = bool
        Items["MainFrame"].Instance.Visible = bool
        -- We'll implement a simple toggle
    end

    function Window:SetCenter()
        -- Center on screen
        Items["MainFrame"].Instance.AnchorPoint = Vector2New(0,0)
        Items["MainFrame"].Instance.Position = UDim2New(0, (workspace.CurrentCamera.ViewportSize.X - 420)/2, 0, (workspace.CurrentCamera.ViewportSize.Y - 720)/2)
    end

    function Window:SetTitle(text)
        Items["Title"].Instance.Text = text
    end

    function Window:SetSubTitle(text)
        Items["SubTitle"].Instance.Text = text
    end

    function Window:SetLogo(id)
        Items["Logo"].Instance.Image = "rbxassetid://" .. tostring(id)
    end

    -- Background texture methods (HollowLib style)
    function Window:SetBackground(textureId, transparency)
        local id = tostring(textureId)
        if tonumber(id) then id = "rbxassetid://" .. id end
        if not Items["BGImage"] then
            Items["BGImage"] = Inst:Create("ImageLabel", {
                Parent = Items["MainFrame"].Instance,
                Size = UDim2New(1,0,1,0),
                Position = UDim2New(0,0,0,0),
                BackgroundTransparency = 1,
                ZIndex = 0,
            })
        end
        Items["BGImage"].Instance.Image = id
        if transparency then Items["BGImage"].Instance.ImageTransparency = transparency end
    end

    function Window:SetBackgroundColor(color)
        if not Items["BGImage"] then
            Items["BGImage"] = Inst:Create("ImageLabel", {
                Parent = Items["MainFrame"].Instance,
                Size = UDim2New(1,0,1,0),
                Position = UDim2New(0,0,0,0),
                BackgroundTransparency = 1,
                ZIndex = 0,
            })
        end
        Items["BGImage"].Instance.BackgroundColor3 = color
        Items["BGImage"].Instance.Image = ""
    end

    function Window:SetBackgroundTransparency(trans)
        if Items["BGImage"] then
            Items["BGImage"].Instance.ImageTransparency = trans
        end
    end

    function Window:GetBackgroundTransparency()
        return Items["BGImage"] and Items["BGImage"].Instance.ImageTransparency or 0
    end

    function Window:GetBackgroundColor()
        return Items["BGImage"] and Items["BGImage"].Instance.BackgroundColor3 or Theme.Background
    end

    function Window:GetBackgroundImage()
        return Items["BGImage"] and Items["BGImage"].Instance.Image or ""
    end

    function Window:SetAccent(color)
        Theme.Accent = color
        Theme.AccentDark = Color3.fromRGB(math.floor(color.R*180), math.floor(color.G*180), math.floor(color.B*180))
        Library:ChangeTheme("Accent", color)
    end

    -- ===== PAGE METHODS =====
    function Window:AddPage(name, icon)
        local Page = {
            Name = name,
            Icon = icon or "1234567890",
            Window = Window,
            Items = {},
            Sections = {},
            Active = false,
            ColumnsData = {}
        }
        -- Inline page button
        local btn = Inst:Create("TextButton", {
            Parent = Items["LeftTabs"].Instance,
            Text = "",
            AutoButtonColor = false,
            Size = UDim2New(0,200,0,40),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
        })
        btn:AddToTheme({ BackgroundColor3 = "Accent" })
        Inst:Create("UICorner", { Parent = btn.Instance, CornerRadius = UDimNew(0,5) })
        local iconImg = Inst:Create("ImageLabel", {
            Parent = btn.Instance,
            Image = "rbxassetid://" .. icon,
            Size = UDim2New(0,18,0,18),
            Position = UDim2New(0,16,0.5,0),
            AnchorPoint = Vector2New(0,0.5),
            BackgroundTransparency = 1,
        })
        local label = Inst:Create("TextLabel", {
            Parent = btn.Instance,
            Text = name,
            Font = Library.Font,
            TextSize = 14,
            Position = UDim2New(0,45,0.5,0),
            AnchorPoint = Vector2New(0,0.5),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.X,
        })
        label:AddToTheme({ TextColor3 = "Text" })

        -- Page content frame (initially hidden)
        local content = Inst:Create("Frame", {
            Parent = Library.UnusedHolder.Instance,
            Visible = false,
            Size = UDim2New(1,0,1,0),
            BackgroundTransparency = 1,
        })
        -- Two columns inside content
        local col1 = Inst:Create("ScrollingFrame", {
            Parent = content.Instance,
            Size = UDim2New(0.5,-12,1,0),
            Position = UDim2New(0,8,0,8),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2New(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 0,
        })
        local col2 = Inst:Create("ScrollingFrame", {
            Parent = content.Instance,
            Size = UDim2New(0.5,-12,1,0),
            Position = UDim2New(0.5,4,0,8),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2New(0,0,0,0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 0,
        })
        Inst:Create("UIListLayout", { Parent = col1.Instance, Padding = UDimNew(0,8), SortOrder = Enum.SortOrder.LayoutOrder })
        Inst:Create("UIListLayout", { Parent = col2.Instance, Padding = UDimNew(0,8), SortOrder = Enum.SortOrder.LayoutOrder })

        Page.ColumnsData = { col1, col2 }
        Page.Items = { Inactive = btn, Icon = iconImg, Text = label, Page = content, Columns = { col1, col2 } }

        function Page:Turn(bool)
            Page.Active = bool
            if bool then
                content.Instance.Parent = Items["Content"].Instance
                content.Instance.Visible = true
                btn.Instance.BackgroundTransparency = 0.25
                label:ChangeItemTheme({ TextColor3 = "Accent" })
            else
                content.Instance.Parent = Library.UnusedHolder.Instance
                content.Instance.Visible = false
                btn.Instance.BackgroundTransparency = 1
                label:ChangeItemTheme({ TextColor3 = "Text" })
            end
        end

        btn:Connect("MouseButton1Down", function()
            for _, p in pairs(Window.Pages) do
                if p ~= Page then p:Turn(false) end
            end
            Page:Turn(true)
        end)

        if #Window.Pages == 0 then Page:Turn(true) end
        TableInsert(Window.Pages, Page)

        return Page
    end

    -- ===== SECTION METHODS =====
    function Window:AddSection(page, side, name, desc)
        side = side or 1
        local Section = {
            Name = name,
            Description = desc or "",
            Side = side,
            Page = page,
            Items = {},
            Elements = {}
        }
        local col = page.ColumnsData[side].Instance
        local outer = Inst:Create("Frame", {
            Parent = col,
            Size = UDim2New(1,0,0,45),
            BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        outer:AddToTheme({ BackgroundColor3 = "Section" })
        Inst:Create("UICorner", { Parent = outer.Instance, CornerRadius = UDimNew(0,6) })
        -- Header
        local header = Inst:Create("Frame", {
            Parent = outer.Instance,
            Size = UDim2New(1,0,0,40),
            BackgroundTransparency = 0.65,
        })
        header:AddToTheme({ BackgroundColor3 = "Outline" })
        local headerInner = Inst:Create("Frame", {
            Parent = header.Instance,
            Size = UDim2New(1,-2,1,-2),
            Position = UDim2New(0,1,0,1),
        })
        headerInner:AddToTheme({ BackgroundColor3 = "Section Top" })
        Inst:Create("UICorner", { Parent = headerInner.Instance, CornerRadius = UDimNew(0,4) })
        local title = Inst:Create("TextLabel", {
            Parent = headerInner.Instance,
            Text = name,
            Font = Library.Font,
            TextSize = 15,
            Position = UDim2New(0,50,0,10),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.X,
        })
        title:AddToTheme({ TextColor3 = "Text" })
        local descLabel = Inst:Create("TextLabel", {
            Parent = headerInner.Instance,
            Text = desc,
            Font = Library.Font,
            TextSize = 14,
            Position = UDim2New(0,50,0,28),
            BackgroundTransparency = 1,
            TextTransparency = 0.4,
            AutomaticSize = Enum.AutomaticSize.X,
        })
        descLabel:AddToTheme({ TextColor3 = "Text" })

        -- Content (holds widgets)
        local content = Inst:Create("Frame", {
            Parent = outer.Instance,
            Position = UDim2New(0,12,0,40),
            Size = UDim2New(1,-24,0,0),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y,
        })
        Inst:Create("UIListLayout", { Parent = content.Instance, Padding = UDimNew(0,5), SortOrder = Enum.SortOrder.LayoutOrder })
        Inst:Create("UIPadding", { Parent = content.Instance, PaddingBottom = UDimNew(0,10) })

        Section.Items = { Outer = outer, Content = content, Title = title }

        function Section:AddToggle(data)
            -- Toggle implementation
            local toggle = {}
            local frame = Inst:Create("TextButton", {
                Parent = content.Instance,
                Size = UDim2New(1,0,0,18),
                BackgroundTransparency = 1,
                Text = "",
                AutoButtonColor = false,
            })
            local indicator = Inst:Create("Frame", {
                Parent = frame.Instance,
                Size = UDim2New(0,18,0,18),
                Position = UDim2New(0,0,0,0),
                BorderSizePixel = 0,
            })
            indicator:AddToTheme({ BackgroundColor3 = "Element" })
            Inst:Create("UICorner", { Parent = indicator.Instance, CornerRadius = UDimNew(0,3) })
            local label = Inst:Create("TextLabel", {
                Parent = frame.Instance,
                Text = data.Name or "Toggle",
                Font = Library.Font,
                TextSize = 14,
                Position = UDim2New(0,24,0,0),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.X,
            })
            label:AddToTheme({ TextColor3 = "Text" })
            toggle.Value = data.Default or false
            function toggle:Set(val)
                toggle.Value = val
                Library.Flags[data.Flag] = val
                if data.Callback then data.Callback(val) end
                -- visual update
                if val then
                    indicator:ChangeItemTheme({ BackgroundColor3 = "Accent" })
                else
                    indicator:ChangeItemTheme({ BackgroundColor3 = "Element" })
                end
            end
            frame:Connect("MouseButton1Down", function()
                toggle:Set(not toggle.Value)
            end)
            toggle:Set(toggle.Value)
            Library.SetFlags[data.Flag] = function(v) toggle:Set(v) end
            return toggle
        end

        function Section:AddButton(data)
            local btn = Inst:Create("TextButton", {
                Parent = content.Instance,
                Size = UDim2New(1,0,0,32),
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
            })
            btn:AddToTheme({ BackgroundColor3 = "Element" })
            Inst:Create("UICorner", { Parent = btn.Instance, CornerRadius = UDimNew(0,4) })
            local label = Inst:Create("TextLabel", {
                Parent = btn.Instance,
                Text = data.Name or "Button",
                Font = Library.Font,
                TextSize = 14,
                Position = UDim2New(0.5,0,0.5,0),
                AnchorPoint = Vector2New(0.5,0.5),
                BackgroundTransparency = 1,
            })
            label:AddToTheme({ TextColor3 = "Text" })
            btn:Connect("MouseButton1Down", function()
                if data.Callback then data.Callback() end
            end)
            return { Press = function() if data.Callback then data.Callback() end end }
        end

        function Section:AddSlider(data)
            local slider = {}
            local frame = Inst:Create("Frame", {
                Parent = content.Instance,
                Size = UDim2New(1,0,0,35),
                BackgroundTransparency = 1,
            })
            local label = Inst:Create("TextLabel", {
                Parent = frame.Instance,
                Text = data.Name or "Slider",
                Font = Library.Font,
                TextSize = 14,
                Position = UDim2New(0,0,0,0),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.X,
            })
            label:AddToTheme({ TextColor3 = "Text" })
            local bar = Inst:Create("TextButton", {
                Parent = frame.Instance,
                Size = UDim2New(1,-40,0,7),
                Position = UDim2New(0,20,1,-3),
                Text = "",
                AutoButtonColor = false,
            })
            bar:AddToTheme({ BackgroundColor3 = "Element" })
            Inst:Create("UICorner", { Parent = bar.Instance, CornerRadius = UDimNew(0,2) })
            local fill = Inst:Create("Frame", {
                Parent = bar.Instance,
                Size = UDim2New(0,0,1,0),
                BorderSizePixel = 0,
            })
            fill:AddToTheme({ BackgroundColor3 = "Accent" })
            local valLabel = Inst:Create("TextLabel", {
                Parent = frame.Instance,
                Text = "",
                Font = Library.Font,
                TextSize = 14,
                Position = UDim2New(1,0,0,0),
                AnchorPoint = Vector2New(1,0),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.X,
            })
            valLabel:AddToTheme({ TextColor3 = "Text" })
            slider.Value = data.Default or 0
            slider.Min = data.Min or 0
            slider.Max = data.Max or 100
            slider.Decimals = data.Decimals or 0
            slider.Suffix = data.Suffix or ""
            function slider:Set(val)
                val = MathClamp(val, self.Min, self.Max)
                slider.Value = val
                local alpha = (val - self.Min) / (self.Max - self.Min)
                fill.Instance.Size = UDim2New(alpha,0,1,0)
                valLabel.Instance.Text = tostring(val) .. self.Suffix
                Library.Flags[data.Flag] = val
                if data.Callback then data.Callback(val) end
            end
            bar:Connect("InputBegan", function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    local x = (inp.Position.X - bar.Instance.AbsolutePosition.X) / bar.Instance.AbsoluteSize.X
                    local val = slider.Min + (slider.Max - slider.Min) * MathClamp(x,0,1)
                    slider:Set(val)
                    while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                        x = (Mouse.X - bar.Instance.AbsolutePosition.X) / bar.Instance.AbsoluteSize.X
                        val = slider.Min + (slider.Max - slider.Min) * MathClamp(x,0,1)
                        slider:Set(val)
                        RunService.Heartbeat:Wait()
                    end
                end
            end)
            slider:Set(slider.Value)
            Library.SetFlags[data.Flag] = function(v) slider:Set(v) end
            return slider
        end

        function Section:AddDropdown(data)
            local dropdown = {}
            local frame = Inst:Create("Frame", {
                Parent = content.Instance,
                Size = UDim2New(1,0,0,25),
                BackgroundTransparency = 1,
            })
            local label = Inst:Create("TextLabel", {
                Parent = frame.Instance,
                Text = data.Name or "Dropdown",
                Font = Library.Font,
                TextSize = 14,
                Position = UDim2New(0,0,0.5,0),
                AnchorPoint = Vector2New(0,0.5),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.X,
            })
            label:AddToTheme({ TextColor3 = "Text" })
            local btn = Inst:Create("TextButton", {
                Parent = frame.Instance,
                Size = UDim2New(0,120,0,20),
                Position = UDim2New(1,0,0,2),
                AnchorPoint = Vector2New(1,0),
                Text = "",
                AutoButtonColor = false,
            })
            btn:AddToTheme({ BackgroundColor3 = "Element" })
            Inst:Create("UICorner", { Parent = btn.Instance, CornerRadius = UDimNew(0,4) })
            local valLabel = Inst:Create("TextLabel", {
                Parent = btn.Instance,
                Text = data.Default or "...",
                Font = Library.Font,
                TextSize = 14,
                Position = UDim2New(0,8,0.5,0),
                AnchorPoint = Vector2New(0,0.5),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2New(1,-20,0,0),
            })
            valLabel:AddToTheme({ TextColor3 = "Text" })
            dropdown.Value = data.Default
            dropdown.Items = data.Items or {}
            dropdown.Multi = data.Multi or false
            function dropdown:Set(val)
                dropdown.Value = val
                valLabel.Instance.Text = tostring(val)
                Library.Flags[data.Flag] = val
                if data.Callback then data.Callback(val) end
            end
            btn:Connect("MouseButton1Down", function()
                -- Simple dropdown popup (placeholder)
                local choice = dropdown.Items[1] or "None"
                dropdown:Set(choice)
            end)
            dropdown:Set(dropdown.Value)
            Library.SetFlags[data.Flag] = function(v) dropdown:Set(v) end
            return dropdown
        end

        function Section:AddTextbox(data)
            local textbox = {}
            local frame = Inst:Create("Frame", {
                Parent = content.Instance,
                Size = UDim2New(1,0,0,32),
                BackgroundTransparency = 1,
            })
            local label = Inst:Create("TextLabel", {
                Parent = frame.Instance,
                Text = data.Name or "Textbox",
                Font = Library.Font,
                TextSize = 14,
                Position = UDim2New(0,0,0.5,0),
                AnchorPoint = Vector2New(0,0.5),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.X,
            })
            label:AddToTheme({ TextColor3 = "Text" })
            local box = Inst:Create("TextBox", {
                Parent = frame.Instance,
                Size = UDim2New(1,0,1,0),
                Position = UDim2New(0,30,0,0),
                Font = Library.Font,
                TextSize = 14,
                Text = data.Default or "",
                PlaceholderText = data.Placeholder or "",
                BackgroundColor3 = Theme.Element,
                TextColor3 = Theme.Text,
                ClearTextOnFocus = false,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            textbox.Value = data.Default or ""
            function textbox:Set(val)
                textbox.Value = val
                box.Text = val
                Library.Flags[data.Flag] = val
                if data.Callback then data.Callback(val) end
            end
            box:GetPropertyChangedSignal("Text"):Connect(function()
                textbox:Set(box.Text)
            end)
            Library.SetFlags[data.Flag] = function(v) textbox:Set(v) end
            return textbox
        end

        function Section:AddLabel(data)
            local label = Inst:Create("TextLabel", {
                Parent = content.Instance,
                Text = data.Name or "Label",
                Font = Library.Font,
                TextSize = 14,
                Size = UDim2New(1,0,0,15),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            label:AddToTheme({ TextColor3 = "Text" })
            return { SetText = function(t) label.Text = t end }
        end

        function Section:AddKeybind(data)
            -- Placeholder
            print("Keybind added")
            return {}
        end

        function Section:AddColorpicker(data)
            -- Placeholder
            print("Colorpicker added")
            return {}
        end

        -- Global chat method
        function Page:GlobalChat(side)
            -- Placeholder
            print("GlobalChat added")
            return {}
        end

        TableInsert(page.Sections, Section)
        return Section
    end

    -- ===== ADD PAGE SHORTCUT =====
    function Window:Page(data)
        return Window:AddPage(data.Name, data.Icon)
    end

    -- ===== SECTION SHORTCUT =====
    function Window:Section(page, side, name, desc)
        return Window:AddSection(page, side, name, desc)
    end

    -- Center and show
    Window:SetCenter()
    Window:SetOpen(true)

    return Window
end

-- ============================================================
-- SETTINGS PAGE
-- ============================================================

Library.CreateSettingsPage = function(self, Window)
    local Page = Window:Page({ Name = "Settings", Icon = "122669828593160" })
    local Configs = Window:AddSection(Page, 2, "Configs")
    local ConfigName, ConfigSelected
    local dropdown = Configs:AddDropdown({
        Name = "Configs",
        Flag = "ConfigsList",
        Items = {},
        Callback = function(v) ConfigSelected = v end
    })
    Configs:AddTextbox({ Name = "Config Name", Flag = "ConfigName", Placeholder = "Name", Finished = true, Callback = function(v) ConfigName = v end })
    Configs:AddButton({ Name = "Create", Callback = function()
        if ConfigName and ConfigName ~= "" then
            if not isfile(Library.Folders.Configs .. "/" .. ConfigName .. ".json") then
                writefile(Library.Folders.Configs .. "/" .. ConfigName .. ".json", Library:GetConfig())
                Library:RefreshConfigsList(dropdown)
            end
        end
    end })
    Configs:AddButton({ Name = "Delete", Callback = function()
        if ConfigSelected then Library:DeleteConfig(ConfigSelected); Library:RefreshConfigsList(dropdown) end
    end })
    Configs:AddButton({ Name = "Load", Callback = function()
        if ConfigSelected then Library:LoadConfig(readfile(Library.Folders.Configs .. "/" .. ConfigSelected)) end
    end })
    Configs:AddButton({ Name = "Save", Callback = function()
        if ConfigSelected then writefile(Library.Folders.Configs .. "/" .. ConfigSelected, Library:GetConfig()) end
    end })
    Configs:AddButton({ Name = "Refresh", Callback = function() Library:RefreshConfigsList(dropdown) end })

    -- Theming
    local ThemeSection = Window:AddSection(Page, 1, "Theming")
    for k,v in pairs(Library.Theme) do
        ThemeSection:AddLabel({ Name = k })
        -- Colorpicker for each theme property
    end

    return Page
end

-- ============================================================
-- RETURN
-- ============================================================

getgenv().Library = Library
return Library
