-- =====================================================================
-- HollowLib v2.1 | Made by hollowoodz (improved)
-- Red & Dark Theme | Left Sidebar | Two Column Layout | Mobile Support
-- =====================================================================

local HollowLib = {}
HollowLib.__index = HollowLib
HollowLib.Flags = {}

-- Global keybind registry with conflict detection
local _keybindRegistry = {}
local _usedKeys = {}

local function RegisterKeybind(kb)
    if kb.getKey() and kb.getKey() ~= Enum.KeyCode.Unknown then
        _usedKeys[kb.getKey()] = (_usedKeys[kb.getKey()] or 0) + 1
    end
    _keybindRegistry[#_keybindRegistry+1] = kb
end

local function UnregisterKeybind(kb)
    if kb.getKey() and kb.getKey() ~= Enum.KeyCode.Unknown then
        _usedKeys[kb.getKey()] = math.max(0, (_usedKeys[kb.getKey()] or 0) - 1)
    end
    for i = #_keybindRegistry, 1, -1 do
        if _keybindRegistry[i] == kb then table.remove(_keybindRegistry, i) break end
    end
end

local function IsKeyUsed(key)
    return (_usedKeys[key] or 0) > 0
end

game:GetService("UserInputService").InputBegan:Connect(function(input, gpe)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    for _, kb in ipairs(_keybindRegistry) do
        if not kb.isListening() and input.KeyCode == kb.getKey() and kb.getKey() ~= Enum.KeyCode.Unknown then
            pcall(function()
                local parent = kb.parentToggle
                if parent and parent.SetValue then
                    if kb.mode == 'Toggle' then
                        parent:SetValue(not parent.Value)
                    elseif kb.mode == 'Hold' then
                        parent:SetValue(true)
                    end
                end
            end)
        end
    end
end)
game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.Keyboard then return end
    for _, kb in ipairs(_keybindRegistry) do
        if kb.mode == 'Hold' and input.KeyCode == kb.getKey() and kb.getKey() ~= Enum.KeyCode.Unknown then
            pcall(function()
                local parent = kb.parentToggle
                if parent and parent.SetValue then
                    parent:SetValue(false)
                end
            end)
        end
    end
end)

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local isMobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled

-- Polyfills
if not math.clamp then
    math.clamp = function(v, lo, hi) return math.min(math.max(v, lo), hi) end
end
if not getgenv then
    getgenv = function() return _G end
end

local env = getgenv()

-- Safe dummy
local SafeDummy = {}
SafeDummy.Value = nil
function SafeDummy:SetValue() end
function SafeDummy:SetValues() end
function SafeDummy:GetValue() return nil end
function SafeDummy:OnChanged() end

if not env.Options then env.Options = setmetatable({}, {__index = function() return SafeDummy end}) end
if not env.Toggles then env.Toggles = setmetatable({}, {__index = function() return SafeDummy end}) end

-- Theme
local Theme = {
    Background  = Color3.fromRGB(10, 10, 12),
    Sidebar     = Color3.fromRGB(14, 14, 17),
    GroupBG     = Color3.fromRGB(18, 18, 22),
    GroupHeader = Color3.fromRGB(22, 22, 27),
    ItemBG      = Color3.fromRGB(24, 24, 30),
    Accent      = Color3.fromRGB(220, 30, 30),
    AccentDark  = Color3.fromRGB(160, 20, 20),
    Text        = Color3.fromRGB(240, 240, 240),
    TextDim     = Color3.fromRGB(160, 160, 170),
    TextDisabled= Color3.fromRGB(90, 90, 100),
    Border      = Color3.fromRGB(35, 35, 42),
    BorderBright= Color3.fromRGB(55, 55, 65),
    Toggle      = Color3.fromRGB(30, 30, 38),
    ToggleOn    = Color3.fromRGB(220, 30, 30),
    SliderBG    = Color3.fromRGB(25, 25, 32),
    SliderFill  = Color3.fromRGB(220, 30, 30),
    DropBG      = Color3.fromRGB(20, 20, 26),
    DropOpen    = Color3.fromRGB(16, 16, 20),
    ScrollBar   = Color3.fromRGB(60, 60, 75),
    TabActive   = Color3.fromRGB(220, 30, 30),
    TabInactive = Color3.fromRGB(14, 14, 17),
    TabHover    = Color3.fromRGB(30, 20, 22),
    Watermark   = Color3.fromRGB(14, 14, 17),
}

local Radius = {
    Window  = 14,
    Group   = 12,
    Item    = 10,
    Button  = 10,
    Toggle  = 10,
    Small   = 8,
    Pill    = 14,
    Dot     = 3,
}

local function Tween(obj, props, t, style, dir)
    TweenService:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props):Play()
end

local function MakeCorner(p, r) local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, r or Radius.Item) c.Parent = p return c end
local function MakeStroke(p, c, t) local s = Instance.new("UIStroke") s.Color = c or Theme.Border s.Thickness = t or 1 s.Parent = p return s end
local function MakePadding(p, t, b, l, r) local u = Instance.new("UIPadding") u.PaddingTop = UDim.new(0, t or 6) u.PaddingBottom = UDim.new(0, b or 6) u.PaddingLeft = UDim.new(0, l or 8) u.PaddingRight = UDim.new(0, r or 8) u.Parent = p end
local function MakeList(p, pad, fill) local l = Instance.new("UIListLayout") l.Padding = UDim.new(0, pad or 3) l.FillDirection = fill or Enum.FillDirection.Vertical l.SortOrder = Enum.SortOrder.LayoutOrder l.Parent = p return l end

local function MakeLabel(p, txt, sz, c, f, xa)
    local l = Instance.new("TextLabel")
    l.Text = txt or "" l.TextSize = sz or 13 l.TextColor3 = c or Theme.Text
    l.Font = f or Enum.Font.GothamMedium l.BackgroundTransparency = 1
    l.TextXAlignment = xa or Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Size = UDim2.new(1, 0, 0, (sz or 13) + 4) l.Parent = p return l
end

local function MakeFrame(p, s, pos, c, tr)
    local f = Instance.new("Frame")
    f.Size = s or UDim2.new(1,0,0,30) f.Position = pos or UDim2.new(0,0,0,0)
    f.BackgroundColor3 = c or Theme.Background f.BackgroundTransparency = tr or 0
    f.BorderSizePixel = 0 f.Parent = p return f
end

local function MakeButton(p, s, pos, c)
    local b = Instance.new("TextButton")
    b.Size = s or UDim2.new(1,0,0,30) b.Position = pos or UDim2.new(0,0,0,0)
    b.BackgroundColor3 = c or Theme.ItemBG b.BorderSizePixel = 0
    b.Text = "" b.AutoButtonColor = false b.Parent = p return b
end

local function MakeImage(p, id, s, pos)
    local i = Instance.new("ImageLabel") i.Image = id or ""
    i.Size = s or UDim2.new(0,16,0,16) i.Position = pos or UDim2.new(0,0,0,0)
    i.BackgroundTransparency = 1 i.Parent = p return i
end

local function MakeDraggable(bar, win, getLocked)
    local drag, di, ds, sp = false
    bar.InputBegan:Connect(function(i)
        if getLocked and getLocked() then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true ds = i.Position sp = win.Position
        end
    end)
    bar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ds
            win.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "HollowLib" ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling ScreenGui.IgnoreGuiInset = true
pcall(function() ScreenGui.Parent = game:GetService("CoreGui") end)
if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer.PlayerGui end

-- Store reference for later access
HollowLib._ScreenGui = ScreenGui

-- Notification system
local notifStack = {}
local function PushNotification(title, desc, duration, icon)
    duration = duration or 3
    for _, nf in ipairs(notifStack) do
        local cur = nf.Position
        Tween(nf, {Position=UDim2.new(cur.X.Scale,cur.X.Offset,cur.Y.Scale,cur.Y.Offset-56)}, 0.35, Enum.EasingStyle.Quint)
    end

    local NF = MakeFrame(ScreenGui, UDim2.new(0,250,0,48), UDim2.new(1,12,1,-60), Theme.Background)
    NF.BackgroundTransparency = 0.08
    NF.ClipsDescendants = true
    MakeCorner(NF, 10)
    local NFStroke = MakeStroke(NF, Theme.Accent, 1)
    NFStroke.Transparency = 0.6

    local NBar = MakeFrame(NF, UDim2.new(0,3,1,-10), UDim2.new(0,6,0,5), Theme.Accent)
    MakeCorner(NBar, 2)

    local NTitle = MakeLabel(NF, title, 11, Theme.Text, Enum.Font.GothamBold)
    NTitle.Size = UDim2.new(1,-24,0,14) NTitle.Position = UDim2.new(0,16,0,6)

    local NDesc = MakeLabel(NF, desc, 9, Theme.TextDim, Enum.Font.Gotham)
    NDesc.Size = UDim2.new(1,-24,0,13) NDesc.Position = UDim2.new(0,16,0,22)
    NDesc.TextWrapped = true

    local NProgress = MakeFrame(NF, UDim2.new(1,0,0,2), UDim2.new(0,0,1,-2), Theme.Accent)
    NProgress.BackgroundTransparency = 0.5
    MakeCorner(NProgress, 1)

    table.insert(notifStack, 1, NF)

    Tween(NF, {Position=UDim2.new(1,-262,1,-60)}, 0.4, Enum.EasingStyle.Quint)

    task.delay(0.45, function()
        Tween(NProgress, {Size=UDim2.new(0,0,0,2)}, duration - 0.5, Enum.EasingStyle.Linear)
    end)

    task.delay(duration, function()
        Tween(NF, {Position=UDim2.new(1,12,1,-60)}, 0.35, Enum.EasingStyle.Quint)
        Tween(NFStroke, {Transparency=1}, 0.3)
        task.wait(0.4)
        for i, v in ipairs(notifStack) do if v == NF then table.remove(notifStack, i) break end end
        NF:Destroy()
    end)

    return NF
end

-- ===== MAIN WINDOW CONSTRUCTOR =====
function HollowLib:CreateWindow(config)
    local Window = {}
    local Tabs = {}
    local ActiveTab = nil
    local uiVisible = true
    local uiLocked = false
    local hideKey = config.HideKey or Enum.KeyCode.RightControl
    
    -- NEW: Custom size, logo visibility, title type
    local winWidth = config.Width or 420       -- narrower default
    local winHeight = config.Height or 520     -- taller default
    local showLogo = config.ShowLogo
    if showLogo == nil then showLogo = true end
    local titleType = config.TitleType or "static"
    local words = config.Words or {"Welcome"}
    
    local curW, curH = winWidth, winHeight
    local minW, minH = 360, 380

    -- Apply accent
    if config.Accent then
        Theme.Accent = config.Accent
        Theme.AccentDark = Color3.fromRGB(
            math.floor(config.Accent.R * 180),
            math.floor(config.Accent.G * 180),
            math.floor(config.Accent.B * 180)
        )
        Theme.ToggleOn = config.Accent
        Theme.SliderFill = config.Accent
        Theme.TabActive = config.Accent
    end

    -- Main frame
    local Main = MakeFrame(ScreenGui, UDim2.new(0,curW,0,curH), UDim2.new(0.5,-curW/2,0.5,-curH/2), Theme.Background)
    Main.Name = "HollowWindow" Main.ClipsDescendants = true
    Main.BackgroundTransparency = 0.15
    MakeCorner(Main, Radius.Window) MakeStroke(Main, Theme.Border, 1)

    -- Background image
    local BGImage = Instance.new("ImageLabel")
    BGImage.Name = "BackgroundImage"
    BGImage.Size = UDim2.new(1,0,1,0)
    BGImage.Position = UDim2.new(0,0,0,0)
    BGImage.BackgroundTransparency = 1
    BGImage.ImageTransparency = 0.65
    BGImage.ScaleType = Enum.ScaleType.Crop
    BGImage.ZIndex = 0
    BGImage.BorderSizePixel = 0
    BGImage.Parent = Main
    MakeCorner(BGImage, Radius.Window)
    if config.Background then
        local bgId = tostring(config.Background)
        if tonumber(bgId) then bgId = "rbxassetid://" .. bgId end
        BGImage.Image = bgId
    end

    -- Shadow
    local ShadowHolder = Instance.new("Frame")
    ShadowHolder.Size = UDim2.new(1,0,1,0)
    ShadowHolder.BackgroundTransparency = 1
    ShadowHolder.ClipsDescendants = false
    ShadowHolder.Parent = Main

    local Shadow = Instance.new("ImageLabel")
    Shadow.Image = "rbxassetid://6014261993" Shadow.ImageColor3 = Color3.new(0,0,0)
    Shadow.ImageTransparency = 0.5 Shadow.Size = UDim2.new(1,40,1,40)
    Shadow.Position = UDim2.new(0,-20,0,-20) Shadow.BackgroundTransparency = 1
    Shadow.ZIndex = -1 Shadow.Parent = ShadowHolder

    -- Topbar
    local Topbar = Instance.new("Frame")
    Topbar.Size = UDim2.new(1,0,0,34)
    Topbar.Position = UDim2.new(0,0,0,0)
    Topbar.BackgroundColor3 = Theme.Sidebar
    Topbar.BackgroundTransparency = 1
    Topbar.BorderSizePixel = 0
    Topbar.Parent = Main
    MakeCorner(Topbar, Radius.Window)
    local TopbarFill = Instance.new("Frame")
    TopbarFill.Size = UDim2.new(1,0,0.5,0)
    TopbarFill.Position = UDim2.new(0,0,0.5,0)
    TopbarFill.BackgroundColor3 = Theme.Sidebar
    TopbarFill.BackgroundTransparency = 1
    TopbarFill.BorderSizePixel = 0
    TopbarFill.Parent = Topbar

    -- Logo (optional)
    local LogoImg = nil
    if showLogo then
        LogoImg = Instance.new("ImageLabel")
        LogoImg.Name = "Logo"
        LogoImg.Image = config.Logo or "rbxassetid://87465223885645"
        LogoImg.Size = UDim2.new(0,50,0,50)
        LogoImg.Position = UDim2.new(0,2,0.5,-25)
        LogoImg.BackgroundTransparency = 1
        LogoImg.BorderSizePixel = 0
        LogoImg.ScaleType = Enum.ScaleType.Fit
        LogoImg.ZIndex = 5
        LogoImg.Parent = Topbar
    end

    -- Title container (for both static and sliding)
    local TitleContainer = Instance.new("Frame")
    TitleContainer.Size = UDim2.new(1, (showLogo and -100 or -20), 1, 0)
    TitleContainer.Position = UDim2.new(showLogo and 0.5 or 0, showLogo and 54 or 10, 0, 0)
    TitleContainer.BackgroundTransparency = 1
    TitleContainer.ClipsDescendants = true
    TitleContainer.Parent = Topbar

    if titleType == "sliding" then
        -- Sliding text
        local currentLabel = Instance.new("TextLabel")
        currentLabel.Size = UDim2.new(1, 0, 1, 0)
        currentLabel.Position = UDim2.new(0, 0, 0, 0)
        currentLabel.BackgroundTransparency = 1
        currentLabel.Text = words[1] or "Welcome"
        currentLabel.TextColor3 = Theme.Text
        currentLabel.Font = Enum.Font.GothamBold
        currentLabel.TextSize = 15
        currentLabel.TextXAlignment = Enum.TextXAlignment.Left
        currentLabel.TextYAlignment = Enum.TextYAlignment.Center
        currentLabel.Parent = TitleContainer

        task.spawn(function()
            local i = 1
            while TitleContainer and TitleContainer.Parent do
                local nextIndex = i + 1
                if nextIndex > #words then nextIndex = 1 end

                local nextLabel = Instance.new("TextLabel")
                nextLabel.Size = UDim2.new(1, 0, 1, 0)
                nextLabel.Position = UDim2.new(1, 0, 0, 0)
                nextLabel.BackgroundTransparency = 1
                nextLabel.Text = words[nextIndex] or "Welcome"
                nextLabel.TextColor3 = Theme.Text
                nextLabel.Font = Enum.Font.GothamBold
                nextLabel.TextSize = 15
                nextLabel.TextXAlignment = Enum.TextXAlignment.Left
                nextLabel.TextYAlignment = Enum.TextYAlignment.Center
                nextLabel.Parent = TitleContainer

                local tweenInfo = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

                TweenService:Create(currentLabel, tweenInfo, {
                    Position = UDim2.new(-1, 0, 0, 0)
                }):Play()

                TweenService:Create(nextLabel, tweenInfo, {
                    Position = UDim2.new(0, 0, 0, 0)
                }):Play()

                task.wait(0.5)
                currentLabel:Destroy()
                currentLabel = nextLabel
                i = nextIndex

                task.wait(1.6)
            end
        end)
    else
        -- Static title
        local TitleLabel = Instance.new("TextLabel")
        TitleLabel.Size = UDim2.new(1, 0, 1, 0)
        TitleLabel.Position = UDim2.new(0, 0, 0, 0)
        TitleLabel.BackgroundTransparency = 1
        TitleLabel.Text = config.Title or "HollowLib"
        TitleLabel.TextColor3 = Theme.Text
        TitleLabel.Font = Enum.Font.GothamBold
        TitleLabel.TextSize = 14
        TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
        TitleLabel.TextYAlignment = Enum.TextYAlignment.Center
        TitleLabel.Parent = TitleContainer
    end

    -- Topbar buttons (minimize)
    local topBtnOffset = -30
    local function makeTopBtn(sym, color, cb)
        local b = MakeButton(Topbar, UDim2.new(0,26,0,26), UDim2.new(1,topBtnOffset,0.5,-13), Theme.Sidebar)
        b.BackgroundTransparency = 1
        MakeCorner(b, Radius.Small)
        local l = MakeLabel(b, sym, 14, color or Theme.TextDim, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
        l.Size = UDim2.new(1,0,1,0) l.TextYAlignment = Enum.TextYAlignment.Center
        b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3=Theme.GroupBG}, 0.15) end)
        b.MouseLeave:Connect(function() Tween(b, {BackgroundColor3=Theme.Sidebar}, 0.15) end)
        b.MouseButton1Click:Connect(cb)
        topBtnOffset = topBtnOffset - 32
        return b, l
    end

    local minimized = false
    local minBtn, minLabel = makeTopBtn("─", Theme.TextDim, function()
        minimized = not minimized
        if minimized then
            Main.Size = UDim2.new(0, curW, 0, 34)
            Main.Position = UDim2.new(0.5, -curW/2, 0.5, -17)
            Content.Visible = false
            ResizeHandle.Visible = false
            minLabel.Text = "□"
        else
            Main.Size = UDim2.new(0, curW, 0, curH)
            Main.Position = UDim2.new(0.5, -curW/2, 0.5, -curH/2)
            Content.Visible = true
            ResizeHandle.Visible = true
            minLabel.Text = "─"
        end
    end)

    -- Mobile floating controls
    local floatGroup = Instance.new("Frame")
    floatGroup.Size = UDim2.new(0,0,0,0) floatGroup.BackgroundTransparency = 1 floatGroup.Parent = ScreenGui

    if isMobile then
        local TogFloat = MakeButton(floatGroup, UDim2.new(0,70,0,26), UDim2.new(0,12,0.22,0), Theme.Watermark)
        TogFloat.BackgroundTransparency = 0.3 MakeCorner(TogFloat, 8) MakeStroke(TogFloat, Theme.Border, 1)
        local TogFloatL = MakeLabel(TogFloat, "Toggle UI", 9, Theme.TextDim, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
        TogFloatL.Size = UDim2.new(1,0,1,0) TogFloatL.TextYAlignment = Enum.TextYAlignment.Center
        MakeDraggable(TogFloat, TogFloat)
        TogFloat.MouseButton1Click:Connect(function()
            uiVisible = not uiVisible
            Main.Visible = uiVisible
        end)

        local LockFloat = MakeButton(floatGroup, UDim2.new(0,62,0,26), UDim2.new(0,12,0.22,30), Theme.Watermark)
        LockFloat.BackgroundTransparency = 0.3 MakeCorner(LockFloat, 8) MakeStroke(LockFloat, Theme.Border, 1)
        local LockFloatL = MakeLabel(LockFloat, "Lock UI", 9, Theme.TextDim, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
        LockFloatL.Size = UDim2.new(1,0,1,0) LockFloatL.TextYAlignment = Enum.TextYAlignment.Center
        MakeDraggable(LockFloat, LockFloat)
        LockFloat.MouseButton1Click:Connect(function()
            uiLocked = not uiLocked
            LockFloatL.Text = uiLocked and "Locked" or "Lock UI"
        end)

        local hideFloatTimer
        local function resetFloatTimer()
            floatGroup.Visible = true
            if hideFloatTimer then task.cancel(hideFloatTimer) end
            hideFloatTimer = task.delay(4, function()
                floatGroup.Visible = false
            end)
        end
        floatGroup.Visible = true
        resetFloatTimer()
        UserInputService.TouchBegan:Connect(resetFloatTimer)
        UserInputService.MouseButton1Down:Connect(resetFloatTimer)
    end

    MakeDraggable(Topbar, Main, function() return uiLocked end)

    -- Content
    local Content = MakeFrame(Main, UDim2.new(1,0,1,-34), UDim2.new(0,0,0,34), Theme.Background)
    Content.Name = "HollowContent"
    Content.BackgroundTransparency = 1
    Content.ClipsDescendants = true
    MakeCorner(Content, Radius.Window)

    -- Sidebar
    local sideExpanded = 120
    local sideCollapsed = 42
    local sideOpen = true

    local Sidebar = MakeFrame(Content, UDim2.new(0,sideExpanded,1,0), nil, Theme.Sidebar)
    Sidebar.BackgroundTransparency = 0.95
    Sidebar.ClipsDescendants = true
    MakeCorner(Sidebar, Radius.Window)
    MakeStroke(Sidebar, Theme.Border, 1)

    local SideTitle = MakeLabel(Sidebar, config.MenuTitle or "MENU", 9, Theme.TextDisabled, Enum.Font.GothamBold)
    SideTitle.Size = UDim2.new(1,-20,0,16) SideTitle.Position = UDim2.new(0,12,0,10)
    SideTitle.TextXAlignment = Enum.TextXAlignment.Center

    local TabList = MakeFrame(Sidebar, UDim2.new(1,0,1,-46), UDim2.new(0,0,0,32), Theme.Sidebar)
    TabList.BackgroundTransparency = 1
    TabList.ClipsDescendants = true
    MakeList(TabList, 5) MakePadding(TabList, 4, 6, 10, 10)

    -- Player info
    local PlayerInfo = MakeFrame(Sidebar, UDim2.new(1,0,0,44), UDim2.new(0,0,1,-44), Theme.Sidebar)
    PlayerInfo.BackgroundTransparency = 1
    MakeStroke(PlayerInfo, Theme.Border, 1)
    MakePadding(PlayerInfo, 6, 6, 10, 10)

    local PlayerAvatar = Instance.new("ImageLabel")
    PlayerAvatar.Size = UDim2.new(0,26,0,26)
    PlayerAvatar.Position = UDim2.new(0,0,0.5,-13)
    PlayerAvatar.BackgroundColor3 = Theme.GroupBG
    PlayerAvatar.BorderSizePixel = 0
    PlayerAvatar.ScaleType = Enum.ScaleType.Fit
    PlayerAvatar.Image = "rbxthumb://type=AvatarHeadShot&id="..LocalPlayer.UserId.."&w=150&h=150"
    PlayerAvatar.Parent = PlayerInfo
    MakeCorner(PlayerAvatar, 13)

    local PlayerName = MakeLabel(PlayerInfo, config.DisplayName or LocalPlayer.DisplayName, 11, Theme.Text, Enum.Font.GothamMedium)
    PlayerName.Size = UDim2.new(1,-34,1,0)
    PlayerName.Position = UDim2.new(0,32,0,0)
    PlayerName.TextYAlignment = Enum.TextYAlignment.Center
    PlayerName.TextTruncate = Enum.TextTruncate.None
    PlayerName.ClipsDescendants = false

    -- Tab content
    local TabContent = MakeFrame(Content, UDim2.new(1,-sideExpanded,1,0), UDim2.new(0,sideExpanded,0,0), Theme.Background)
    TabContent.BackgroundTransparency = 1
    TabContent.ClipsDescendants = true

    -- Sidebar collapse/expand
    local allTabLabels = {}
    if not isMobile then
        local function CollapseSidebar()
            if not sideOpen then return end
            sideOpen = false
            Tween(Sidebar, {Size=UDim2.new(0,sideCollapsed,1,0)}, 0.3, Enum.EasingStyle.Quint)
            Tween(TabContent, {Size=UDim2.new(1,-sideCollapsed,1,0), Position=UDim2.new(0,sideCollapsed,0,0)}, 0.3, Enum.EasingStyle.Quint)
            Tween(SideTitle, {TextTransparency=1}, 0.15)
            Tween(PlayerName, {TextTransparency=1}, 0.15)
            for _, lbl in ipairs(allTabLabels) do Tween(lbl, {TextTransparency=1}, 0.15) end
        end
        local function ExpandSidebar()
            if sideOpen then return end
            sideOpen = true
            Tween(Sidebar, {Size=UDim2.new(0,sideExpanded,1,0)}, 0.3, Enum.EasingStyle.Quint)
            Tween(TabContent, {Size=UDim2.new(1,-sideExpanded,1,0), Position=UDim2.new(0,sideExpanded,0,0)}, 0.3, Enum.EasingStyle.Quint)
            Tween(SideTitle, {TextTransparency=0}, 0.2)
            Tween(PlayerName, {TextTransparency=0}, 0.2)
            for _, lbl in ipairs(allTabLabels) do Tween(lbl, {TextTransparency=0}, 0.2) end
        end
        Sidebar.MouseEnter:Connect(ExpandSidebar)
        TabContent.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                CollapseSidebar()
            end
        end)
    end

    -- Watermark
    local wmName = config.WatermarkName or "hollowoodz"
    local Watermark = MakeFrame(ScreenGui, UDim2.new(0, isMobile and 220 or 240, 0, 28), UDim2.new(0,12,1,-40), Theme.Watermark)
    Watermark.BackgroundTransparency = 0.3
    MakeCorner(Watermark, 10)
    local WMStroke = MakeStroke(Watermark, Theme.Border, 1)
    MakeDraggable(Watermark, Watermark)

    local WMBar = MakeFrame(Watermark, UDim2.new(0,3,0,16), UDim2.new(0,6,0.5,-8), Theme.Accent)
    MakeCorner(WMBar, 2)

    local WMName = MakeLabel(Watermark, wmName, 10, Theme.Text, Enum.Font.GothamBold)
    WMName.Size = UDim2.new(0,72,1,0) WMName.Position = UDim2.new(0,14,0,0)
    WMName.TextYAlignment = Enum.TextYAlignment.Center
    pcall(function() WMName.AutomaticSize = Enum.AutomaticSize.X end)

    local WMDot1 = MakeFrame(Watermark, UDim2.new(0,3,0,3), UDim2.new(0,88,0.5,-1), Theme.TextDisabled)
    MakeCorner(WMDot1, 2)

    local WMFps = MakeLabel(Watermark, "60fps", 10, Theme.Accent, Enum.Font.GothamMedium)
    WMFps.Size = UDim2.new(0,40,1,0) WMFps.Position = UDim2.new(0,96,0,0)
    WMFps.TextYAlignment = Enum.TextYAlignment.Center WMFps.TextXAlignment = Enum.TextXAlignment.Center

    local WMDot2 = MakeFrame(Watermark, UDim2.new(0,3,0,3), UDim2.new(0,138,0.5,-1), Theme.TextDisabled)
    MakeCorner(WMDot2, 2)

    local WMPing = MakeLabel(Watermark, "0ms", 10, Theme.TextDim, Enum.Font.GothamMedium)
    WMPing.Size = UDim2.new(0,40,1,0) WMPing.Position = UDim2.new(0,146,0,0)
    WMPing.TextYAlignment = Enum.TextYAlignment.Center WMPing.TextXAlignment = Enum.TextXAlignment.Center

    local frameCount, frameTimer, fps = 0, tick(), 60
    local statsOk, stats = pcall(function() return game:GetService("Stats") end)
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        if tick() - frameTimer >= 1 then fps = frameCount frameCount = 0 frameTimer = tick() end
        local ping = 0
        pcall(function()
            if statsOk and stats then ping = math.floor(stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end
        end)
        WMFps.Text = math.floor(fps).."fps"
        WMPing.Text = ping.."ms"
        if fps >= 50 then WMFps.TextColor3 = Theme.Accent
        elseif fps >= 30 then WMFps.TextColor3 = Color3.fromRGB(220, 180, 30)
        else WMFps.TextColor3 = Color3.fromRGB(220, 50, 50) end
    end)

    -- Hide/show keybind
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == hideKey then
            uiVisible = not uiVisible
            Main.Visible = uiVisible
            Watermark.Visible = uiVisible
        end
    end)

    -- Open animation
    Main.Size = UDim2.new(0,curW,0,0) Main.Position = UDim2.new(0.5,-curW/2,0.5,0)
    Tween(Main, {Size=UDim2.new(0,curW,0,curH),Position=UDim2.new(0.5,-curW/2,0.5,-curH/2)}, 0.4, Enum.EasingStyle.Quint)

    -- Resize handle
    local ResizeHandle = Instance.new("TextButton")
    ResizeHandle.Size = UDim2.new(0,16,0,16)
    ResizeHandle.Position = UDim2.new(1,-16,1,-16)
    ResizeHandle.BackgroundTransparency = 1
    ResizeHandle.Text = ""
    ResizeHandle.ZIndex = 10
    ResizeHandle.Parent = Main

    local ResizeDots = MakeLabel(ResizeHandle, "...", 10, Theme.TextDisabled, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
    ResizeDots.Size = UDim2.new(1,0,1,0) ResizeDots.TextYAlignment = Enum.TextYAlignment.Bottom
    ResizeDots.Rotation = -45

    do
        local resizing = false
        local startInput, startSize
        ResizeHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                startInput = input.Position
                startSize = Main.AbsoluteSize
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - startInput
                local newW = math.max(minW, startSize.X + delta.X)
                local newH = math.max(minH, startSize.Y + delta.Y)
                curW = newW curH = newH
                Main.Size = UDim2.new(0, newW, 0, newH)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)
    end

    -- ===== TAB FUNCTIONS (unchanged) =====
    function Window:AddTab(name, icon)
        local Tab = {}
        local isActive = false
        local hasImageIcon = icon and (type(icon) == "number" or tostring(icon):find("rbxassetid"))

        local TabBtn = MakeButton(TabList, UDim2.new(1,0,0,30), nil, Theme.TabInactive)
        TabBtn.BackgroundTransparency = 1
        MakeCorner(TabBtn, Radius.Small)

        local TabIndicator = MakeFrame(TabBtn, UDim2.new(0,3,0,10), UDim2.new(0,0,0.5,-5), Theme.Accent)
        TabIndicator.BackgroundTransparency = 1 MakeCorner(TabIndicator, 2)

        local TabIcon
        if hasImageIcon then
            TabIcon = Instance.new("ImageLabel")
            TabIcon.Size = UDim2.new(0,16,0,16)
            TabIcon.Position = UDim2.new(0,8,0.5,-8)
            TabIcon.BackgroundTransparency = 1
            TabIcon.Image = type(icon) == "number" and ("rbxassetid://"..tostring(icon)) or tostring(icon)
            TabIcon.ImageColor3 = Theme.TextDim
            TabIcon.ScaleType = Enum.ScaleType.Fit
            TabIcon.Parent = TabBtn
        else
            TabIcon = MakeLabel(TabBtn, icon or "", 12, Theme.TextDim, Enum.Font.GothamMedium)
            TabIcon.Size = UDim2.new(0,18,1,0) TabIcon.Position = UDim2.new(0,7,0,0)
            TabIcon.TextXAlignment = Enum.TextXAlignment.Center
        end

        local TabLabel = MakeLabel(TabBtn, name, 11, Theme.TextDim, Enum.Font.GothamMedium)
        TabLabel.Size = UDim2.new(1,-32,1,0) TabLabel.Position = UDim2.new(0,26,0,0)
        table.insert(allTabLabels, TabLabel)

        local TabPage = Instance.new("CanvasGroup")
        TabPage.GroupTransparency = 0
        TabPage.Size = UDim2.new(1,0,1,0)
        TabPage.Position = UDim2.new(0,0,0,0)
        TabPage.BackgroundTransparency = 1
        TabPage.BorderSizePixel = 0
        TabPage.Visible = false
        TabPage.ClipsDescendants = true
        TabPage.Parent = TabContent

        local TabScroll = Instance.new("ScrollingFrame")
        TabScroll.Size = UDim2.new(1,0,1,0)
        TabScroll.BackgroundTransparency = 1 TabScroll.BorderSizePixel = 0
        TabScroll.ScrollBarThickness = 3 TabScroll.ScrollBarImageColor3 = Theme.ScrollBar
        TabScroll.CanvasSize = UDim2.new(0,0,0,9999)
        pcall(function() TabScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y end)
        TabScroll.Parent = TabPage

        local InnerWrap = Instance.new("Frame")
        InnerWrap.Size = UDim2.new(1,-20,0,0)
        InnerWrap.Position = UDim2.new(0,8,0,10)
        InnerWrap.BackgroundTransparency = 1
        InnerWrap.BorderSizePixel = 0
        pcall(function() InnerWrap.AutomaticSize = Enum.AutomaticSize.Y end)
        InnerWrap.Parent = TabScroll

        local ColHolder = MakeFrame(InnerWrap, UDim2.new(1,0,0,0), nil, Theme.Background, 1)
        pcall(function() ColHolder.AutomaticSize = Enum.AutomaticSize.Y end)

        local ColLayout = Instance.new("UIListLayout")
        ColLayout.FillDirection = Enum.FillDirection.Horizontal
        ColLayout.Padding = UDim.new(0, 10)
        ColLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ColLayout.VerticalAlignment = Enum.VerticalAlignment.Top
        ColLayout.Parent = ColHolder

        local LeftCol = MakeFrame(ColHolder, UDim2.new(0.5,-5,0,0), nil, Theme.Background, 1)
        pcall(function() LeftCol.AutomaticSize = Enum.AutomaticSize.Y end)
        MakeList(LeftCol, 8)

        local RightCol = MakeFrame(ColHolder, UDim2.new(0.5,-5,0,0), nil, Theme.Background, 1)
        pcall(function() RightCol.AutomaticSize = Enum.AutomaticSize.Y end)
        MakeList(RightCol, 8)

        local BottomSpacer = Instance.new("Frame")
        BottomSpacer.Size = UDim2.new(1,0,0,16)
        BottomSpacer.Position = UDim2.new(0,0,0,0)
        BottomSpacer.BackgroundTransparency = 1
        BottomSpacer.LayoutOrder = 9999
        BottomSpacer.Parent = InnerWrap
        
        local WrapLayout = Instance.new("UIListLayout")
        WrapLayout.Padding = UDim.new(0, 0)
        WrapLayout.SortOrder = Enum.SortOrder.LayoutOrder
        WrapLayout.Parent = InnerWrap

        local iconColorProp = hasImageIcon and "ImageColor3" or "TextColor3"

        local function Activate()
            if ActiveTab and ActiveTab ~= Tab then ActiveTab:_deactivate() end
            isActive = true ActiveTab = Tab
            TabPage.Visible = true
            TabPage.GroupTransparency = 1
            Tween(TabPage, {GroupTransparency=0}, 0.25, Enum.EasingStyle.Quint)
            TabScroll.CanvasPosition = Vector2.new(0, 0)
            Tween(TabBtn, {BackgroundColor3=Theme.TabHover}, 0.2, Enum.EasingStyle.Quint)
            Tween(TabLabel, {TextColor3=Theme.Text}, 0.2, Enum.EasingStyle.Quint)
            Tween(TabIcon, {[iconColorProp]=Theme.Accent}, 0.2, Enum.EasingStyle.Quint)
            Tween(TabIndicator, {BackgroundTransparency=0, Size=UDim2.new(0,3,0,18)}, 0.25, Enum.EasingStyle.Back)
        end

        function Tab:_deactivate()
            isActive = false
            Tween(TabBtn, {BackgroundColor3=Theme.TabInactive}, 0.2, Enum.EasingStyle.Quint)
            Tween(TabLabel, {TextColor3=Theme.TextDim}, 0.2, Enum.EasingStyle.Quint)
            Tween(TabIcon, {[iconColorProp]=Theme.TextDim}, 0.2, Enum.EasingStyle.Quint)
            Tween(TabIndicator, {BackgroundTransparency=1, Size=UDim2.new(0,3,0,10)}, 0.2, Enum.EasingStyle.Quint)
            Tween(TabPage, {GroupTransparency=1}, 0.15, Enum.EasingStyle.Quint)
            task.delay(0.15, function() if not isActive then TabPage.Visible = false end end)
        end

        TabBtn.MouseEnter:Connect(function()
            if not isActive then Tween(TabBtn, {BackgroundColor3=Color3.fromRGB(22,18,18)}, 0.2, Enum.EasingStyle.Quint) end
        end)
        TabBtn.MouseLeave:Connect(function()
            if not isActive then Tween(TabBtn, {BackgroundColor3=Theme.TabInactive}, 0.2, Enum.EasingStyle.Quint) end
        end)
        TabBtn.MouseButton1Click:Connect(Activate)
        if #Tabs == 0 then Activate() end
        table.insert(Tabs, Tab)

        -- ===== GROUPBOX FUNCTIONS =====
        local function AddGroupInternal(name, col, existingContainer)
            local Group = {}
            local GroupFrame, ItemContainer

            if existingContainer then
                GroupFrame = existingContainer
                ItemContainer = existingContainer
            else
                GroupFrame = MakeFrame(col, UDim2.new(1,0,0,0), nil, Theme.GroupBG)
                pcall(function() GroupFrame.AutomaticSize = Enum.AutomaticSize.Y end)
                GroupFrame.BackgroundTransparency = 1
                MakeCorner(GroupFrame, Radius.Group) MakeStroke(GroupFrame, Theme.Border, 1)
                GroupFrame.ClipsDescendants = false

                local Header = MakeFrame(GroupFrame, UDim2.new(1,0,0,28), nil, Theme.GroupHeader)
                Header.BackgroundTransparency = 1
                MakeCorner(Header, Radius.Group)
                local HeaderFill = MakeFrame(Header, UDim2.new(1,0,0.5,0), UDim2.new(0,0,0.5,0), Theme.GroupHeader)
                HeaderFill.BackgroundTransparency = 1

                local AccentLine = MakeFrame(Header, UDim2.new(0,3,0,12), UDim2.new(0,8,0.5,-6), Theme.Accent)
                MakeCorner(AccentLine, 2)

                local GroupTitle = MakeLabel(Header, name, 11, Theme.Text, Enum.Font.GothamBold)
                GroupTitle.Size = UDim2.new(1,-20,1,0) GroupTitle.Position = UDim2.new(0,18,0,0)
                GroupTitle.TextYAlignment = Enum.TextYAlignment.Center

                ItemContainer = MakeFrame(GroupFrame, UDim2.new(1,0,0,0), UDim2.new(0,0,0,28), Theme.GroupBG)
                pcall(function() ItemContainer.AutomaticSize = Enum.AutomaticSize.Y end)
                ItemContainer.BackgroundTransparency = 1
                MakeCorner(ItemContainer, Radius.Group) MakePadding(ItemContainer, 8, 10, 8, 8)
                MakeList(ItemContainer, 6)
            end

            local dependencyList = {}
            local function RunDependencyChecks()
                for _, row in ipairs(dependencyList) do
                    local visible = true
                    for _, dep in ipairs(row._deps) do
                        local target = dep[1]
                        local required = dep[2]
                        if type(target) == "string" then
                            target = (env.Toggles and env.Toggles[target]) or (env.Options and env.Options[target])
                        end
                        if target and target.Value ~= required then
                            visible = false
                            break
                        end
                    end
                    row.Visible = visible
                end
            end

            local function AddDependencySupport(element, row)
                row._deps = {}
                element._row = row
                function element:SetupDependencies(deps)
                    if not deps or #deps == 0 then return end
                    row._deps = deps
                    table.insert(dependencyList, row)
                    RunDependencyChecks()
                end
            end

            -- AddToggle
            function Group:AddToggle(id, cfg)
                local Toggle = {}
                local state = cfg.Default or false
                local callback = cfg.Callback or function() end

                local Row = MakeFrame(ItemContainer, UDim2.new(1,0,0,24), nil, Theme.ItemBG)
                Row.BackgroundTransparency = 1
                MakePadding(Row, 0, 0, 4, 4)

                local RowBtn = MakeButton(Row, UDim2.new(1,0,1,0), nil, Theme.ItemBG)
                RowBtn.BackgroundTransparency = 1

                local CheckBox = MakeFrame(Row, UDim2.new(0,13,0,13), UDim2.new(0,0,0.5,-6), Theme.Toggle)
                MakeCorner(CheckBox, 3)
                local CheckStroke = MakeStroke(CheckBox, Theme.Border, 1)

                local CheckFill = MakeFrame(CheckBox, UDim2.new(0,7,0,7), UDim2.new(0.5,-3,0.5,-3), Theme.Accent)
                MakeCorner(CheckFill, 2)
                CheckFill.BackgroundTransparency = 1

                local ToggleLabel = MakeLabel(Row, cfg.Text or id, 11, Theme.TextDim, Enum.Font.Gotham)
                ToggleLabel.Size = UDim2.new(1,-20,1,0)
                ToggleLabel.Position = UDim2.new(0,18,0,0)
                ToggleLabel.TextYAlignment = Enum.TextYAlignment.Center

                local onChangedFn = nil
                local function SetState(newState, skipCb)
                    state = newState
                    if state then
                        Tween(CheckBox, {BackgroundColor3=Theme.Accent}, 0.15)
                        Tween(CheckStroke, {Color=Theme.Accent}, 0.15)
                        Tween(CheckFill, {BackgroundTransparency=0}, 0.15)
                        Tween(ToggleLabel, {TextColor3=Theme.Text}, 0.15)
                    else
                        Tween(CheckBox, {BackgroundColor3=Theme.Toggle}, 0.15)
                        Tween(CheckStroke, {Color=Theme.Border}, 0.15)
                        Tween(CheckFill, {BackgroundTransparency=1}, 0.15)
                        Tween(ToggleLabel, {TextColor3=Theme.TextDim}, 0.15)
                    end
                    Toggle.Value = state
                    if not skipCb then callback(state) end
                    if not skipCb and onChangedFn then pcall(onChangedFn, state) end
                    RunDependencyChecks()
                end

                SetState(state, true)
                RowBtn.MouseButton1Click:Connect(function() SetState(not state) end)
                RowBtn.MouseEnter:Connect(function()
                    if not state then Tween(CheckStroke, {Color=Theme.TextDisabled}, 0.1) end
                end)
                RowBtn.MouseLeave:Connect(function()
                    if not state then Tween(CheckStroke, {Color=Theme.Border}, 0.1) end
                end)

                function Toggle:SetValue(v) SetState(v, false) end
                function Toggle:GetValue() return state end
                Toggle.Value = state
                function Toggle:AddColorPicker(pid, pcfg) return Group:AddColorPicker(pid, pcfg) end
                function Toggle:AddKeyPicker(pid, pcfg) pcfg = pcfg or {} pcfg._parentToggle = Toggle return Group:AddKeybindPicker(pid, pcfg) end
                function Toggle:OnChanged(fn) onChangedFn = fn end
                AddDependencySupport(Toggle, Row)

                if id then
                    HollowLib.Flags[id] = Toggle
                    if env.Toggles then env.Toggles[id] = Toggle end
                    if env.Options then env.Options[id] = Toggle end
                end
                return Toggle
            end

            -- AddSlider
            function Group:AddSlider(id, cfg)
                local Slider = {}
                local min = cfg.Min or 0 local max = cfg.Max or 100
                local step = cfg.Step or 1
                local value = math.clamp(cfg.Default or min, min, max)
                local rounding = cfg.Rounding or 0 local suffix = cfg.Suffix or ""
                local callback = cfg.Callback or function() end
                local dragging = false

                local Container = MakeFrame(ItemContainer, UDim2.new(1,0,0,28), nil, Theme.ItemBG)
                Container.BackgroundTransparency = 1
                MakePadding(Container, 1, 1, 4, 4)

                local SliderLabel = MakeLabel(Container, cfg.Text or id, 10, Theme.TextDim, Enum.Font.Gotham)
                SliderLabel.Size = UDim2.new(1,0,0,11)

                local SliderBG = MakeFrame(Container, UDim2.new(1,0,0,12), UDim2.new(0,0,0,14), Theme.SliderBG)
                MakeCorner(SliderBG, 3)

                local alpha = (value-min)/(max-min)

                local SliderFill = MakeFrame(SliderBG, UDim2.new(alpha,0,1,0), nil, Theme.SliderFill)
                MakeCorner(SliderFill, 3)

                local ValueLabel = MakeLabel(SliderBG, tostring(value) .. suffix .. "/" .. tostring(max) .. suffix, 8, Theme.Text, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
                ValueLabel.Size = UDim2.new(1,0,1,0)
                ValueLabel.TextYAlignment = Enum.TextYAlignment.Center
                ValueLabel.ZIndex = 3

                local SliderBtn = MakeButton(SliderBG, UDim2.new(1,0,1,10), UDim2.new(0,0,0,-5), Theme.Background)
                SliderBtn.BackgroundTransparency = 1 SliderBtn.ZIndex = 4

                local sliderOnChanged = nil

                local function UpdateSlider(input)
                    local rel = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
                    local raw = min + (max-min) * rel
                    value = raw - (raw % step)
                    if rounding > 0 then
                        value = math.floor(value * (10^rounding) + 0.5) / (10^rounding)
                    end
                    value = math.clamp(value, min, max)
                    local a = (value-min)/(max-min)
                    Tween(SliderFill, {Size=UDim2.new(a,0,1,0)}, 0.06, Enum.EasingStyle.Quart)
                    ValueLabel.Text = tostring(value) .. suffix .. "/" .. tostring(max) .. suffix
                    Slider.Value = value
                    callback(value)
                    if sliderOnChanged then pcall(sliderOnChanged, value) end
                    RunDependencyChecks()
                end

                SliderBtn.MouseButton1Down:Connect(function() dragging = true end)
                SliderBtn.TouchTap:Connect(function(touches) if touches[1] then UpdateSlider(touches[1]) end end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then UpdateSlider(i) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                function Slider:SetValue(v)
                    value = math.clamp(v,min,max)
                    local a=(value-min)/(max-min)
                    Tween(SliderFill,{Size=UDim2.new(a,0,1,0)},0.15)
                    ValueLabel.Text = tostring(value) .. suffix .. "/" .. tostring(max) .. suffix
                    Slider.Value = value
                    callback(value)
                    if sliderOnChanged then pcall(sliderOnChanged, value) end
                    RunDependencyChecks()
                end
                function Slider:GetValue() return value end
                Slider.Value = value
                function Slider:OnChanged(fn) sliderOnChanged = fn end

                if id then
                    HollowLib.Flags[id] = Slider
                    if env.Options then env.Options[id] = Slider end
                end
                AddDependencySupport(Slider, Container)
                return Slider
            end

            -- AddButton
            function Group:AddButton(textOrCfg, callbackArg)
                local text, callback
                if type(textOrCfg) == "string" then
                    text = textOrCfg
                    callback = callbackArg or function() end
                else
                    text = textOrCfg.Text or "Button"
                    callback = textOrCfg.Func or textOrCfg.Callback or function() end
                end

                local Btn = MakeButton(ItemContainer, UDim2.new(1,0,0,26), nil, Theme.ItemBG)
                Btn.BackgroundTransparency = 1
                MakePadding(Btn, 0, 0, 4, 4)

                local BtnLabel = MakeLabel(Btn, text, 11, Theme.TextDim, Enum.Font.Gotham, Enum.TextXAlignment.Center)
                BtnLabel.Size = UDim2.new(1,0,1,0) BtnLabel.TextYAlignment = Enum.TextYAlignment.Center

                local BtnLine = MakeFrame(Btn, UDim2.new(1,-12,0,1), UDim2.new(0,6,1,-2), Theme.Border)

                Btn.MouseEnter:Connect(function()
                    Tween(BtnLabel, {TextColor3=Theme.Accent}, 0.1)
                    Tween(BtnLine, {BackgroundColor3=Theme.Accent}, 0.1)
                end)
                Btn.MouseLeave:Connect(function()
                    Tween(BtnLabel, {TextColor3=Theme.TextDim}, 0.1)
                    Tween(BtnLine, {BackgroundColor3=Theme.Border}, 0.1)
                end)
                Btn.MouseButton1Click:Connect(callback)
                return Btn
            end

            -- AddDropdown
            function Group:AddDropdown(id, cfg)
                local Dropdown = {}
                local values = cfg.Values or {}
                local selected = cfg.Default or ""
                local multi = cfg.Multi or false
                local multiSelected = {}
                local open = false
                local callback = cfg.Callback or function() end
                local dropOnChanged = nil
                local maxVisible = cfg.MaxVisible or 6

                if type(selected) == "number" and values[selected] then selected = values[selected] end

                local Container = MakeFrame(ItemContainer, UDim2.new(1,0,0,0), nil, Theme.ItemBG)
                Container.BackgroundTransparency = 1
                pcall(function() Container.AutomaticSize = Enum.AutomaticSize.Y end)
                MakePadding(Container, 2, 2, 4, 4)

                local Header = MakeButton(Container, UDim2.new(1,0,0,24), nil, Theme.DropBG)
                Header.BackgroundTransparency = 1
                MakeCorner(Header, 4) MakeStroke(Header, Theme.Border, 1)

                local DropLabel = MakeLabel(Header, cfg.Text or id, 9, Theme.TextDim, Enum.Font.Gotham)
                DropLabel.Size = UDim2.new(1,-24,0,10) DropLabel.Position = UDim2.new(0,6,0,2)

                local SelectedLabel = MakeLabel(Header, tostring(selected), 10, Theme.Text, Enum.Font.GothamMedium)
                SelectedLabel.Size = UDim2.new(1,-24,0,11) SelectedLabel.Position = UDim2.new(0,6,0,12)

                local DropArrow = Instance.new("ImageLabel")
                DropArrow.Size = UDim2.new(0,10,0,10)
                DropArrow.Position = UDim2.new(1,-14,0.5,-5)
                DropArrow.BackgroundTransparency = 1
                DropArrow.Image = "rbxassetid://6031091004"
                DropArrow.ImageColor3 = Theme.TextDim
                DropArrow.ScaleType = Enum.ScaleType.Fit
                DropArrow.Parent = Header

                local hasSearch = cfg.Search or false
                local searchFilter = ""
                local SearchBox
                if hasSearch then
                    SearchBox = Instance.new("TextBox")
                    SearchBox.Size = UDim2.new(1,0,0,18)
                    SearchBox.Position = UDim2.new(0,0,0,28)
                    SearchBox.BackgroundColor3 = Theme.SliderBG
                    SearchBox.BackgroundTransparency = 0.3
                    SearchBox.BorderSizePixel = 0
                    SearchBox.Text = ""
                    SearchBox.PlaceholderText = "Search..."
                    SearchBox.PlaceholderColor3 = Theme.TextDisabled
                    SearchBox.TextColor3 = Theme.Text
                    SearchBox.Font = Enum.Font.Gotham
                    SearchBox.TextSize = 9
                    SearchBox.ClearTextOnFocus = false
                    SearchBox.Visible = false
                    SearchBox.ZIndex = 10
                    SearchBox.Parent = Container
                    MakeCorner(SearchBox, 3)
                    MakePadding(SearchBox, 0, 0, 6, 6)
                end

                local searchH = hasSearch and 20 or 0
                local listH = math.min(#values, maxVisible) * 20 + 6
                local OptionScroll = Instance.new("ScrollingFrame")
                OptionScroll.Size = UDim2.new(1,0,0,listH)
                OptionScroll.Position = UDim2.new(0,0,0,28 + searchH)
                OptionScroll.BackgroundColor3 = Theme.Background
                OptionScroll.BackgroundTransparency = 0.05
                OptionScroll.BorderSizePixel = 0
                OptionScroll.ScrollBarThickness = 3
                OptionScroll.ScrollBarImageColor3 = Theme.ScrollBar
                OptionScroll.CanvasSize = UDim2.new(0,0,0,0)
                pcall(function() OptionScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y end)
                OptionScroll.Visible = false
                OptionScroll.ZIndex = 10
                OptionScroll.Parent = Container
                MakeCorner(OptionScroll, 6) MakeStroke(OptionScroll, Theme.BorderBright, 1)
                MakePadding(OptionScroll, 4, 4, 4, 4)
                MakeList(OptionScroll, 2)

                local function CloseDropdown()
                    open = false
                    OptionScroll.Visible = false
                    if SearchBox then SearchBox.Visible = false SearchBox.Text = "" searchFilter = "" end
                    Tween(DropArrow, {Rotation=0}, 0.2)
                    DropArrow.ImageColor3 = Theme.TextDim
                end

                local function BuildOptions(filter)
                    filter = filter or ""
                    for _, c in pairs(OptionScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
                    local count = 0
                    if not values then values = {} end
                    for _, val in ipairs(values) do
                        local str = tostring(val):lower()
                        if filter == "" or str:find(filter:lower(), 1, true) then
                            count = count + 1
                            local isSel = (multi and multiSelected[val]) or (not multi and selected == val)
                            local Opt = MakeButton(OptionScroll, UDim2.new(1,0,0,18), nil, isSel and Theme.AccentDark or Theme.DropBG)
                            Opt.BackgroundTransparency = isSel and 0.3 or 1
                            MakeCorner(Opt, 3)
                            local OptLabel = MakeLabel(Opt, tostring(val), 10, isSel and Theme.Text or Theme.TextDim, Enum.Font.Gotham)
                            OptLabel.Size = UDim2.new(1,-6,1,0) OptLabel.Position = UDim2.new(0,6,0,0)
                            OptLabel.TextYAlignment = Enum.TextYAlignment.Center

                            Opt.MouseEnter:Connect(function() Tween(OptLabel,{TextColor3=Theme.Text},0.1) end)
                            Opt.MouseLeave:Connect(function() if not isSel then Tween(OptLabel,{TextColor3=Theme.TextDim},0.1) end end)
                            Opt.MouseButton1Click:Connect(function()
                                if multi then
                                    multiSelected[val] = not multiSelected[val]
                                    local result = {} for k,v in pairs(multiSelected) do if v then table.insert(result,k) end end
                                    SelectedLabel.Text = #result>0 and table.concat(result,", ") or "None"
                                    callback(result)
                                else
                                    selected = val SelectedLabel.Text = tostring(val) Dropdown.Value = val callback(val) if dropOnChanged then pcall(dropOnChanged, val) end
                                    CloseDropdown()
                                end
                                BuildOptions(searchFilter)
                                RunDependencyChecks()
                            end)
                        end
                    end
                    listH = math.min(count, maxVisible) * 20 + 6
                    OptionScroll.Size = UDim2.new(1,0,0,listH)
                end

                if SearchBox then
                    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                        searchFilter = SearchBox.Text
                        BuildOptions(searchFilter)
                    end)
                end

                Header.MouseButton1Click:Connect(function()
                    open = not open
                    OptionScroll.Visible = open
                    if SearchBox then SearchBox.Visible = open end
                    Tween(DropArrow, {Rotation=open and 180 or 0}, 0.2)
                    DropArrow.ImageColor3 = open and Theme.Accent or Theme.TextDim
                    if open then BuildOptions(searchFilter) end
                end)
                BuildOptions()

                UserInputService.InputBegan:Connect(function(input)
                    if not open then return end
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        task.defer(function()
                            local pos = input.Position
                            local hAbs = Header.AbsolutePosition
                            local hSz = Header.AbsoluteSize
                            local oAbs = OptionScroll.AbsolutePosition
                            local oSz = OptionScroll.AbsoluteSize
                            local inHeader = pos.X >= hAbs.X and pos.X <= hAbs.X+hSz.X and pos.Y >= hAbs.Y and pos.Y <= hAbs.Y+hSz.Y
                            local inList = pos.X >= oAbs.X and pos.X <= oAbs.X+oSz.X and pos.Y >= oAbs.Y and pos.Y <= oAbs.Y+oSz.Y
                            local inSearch = false
                            if SearchBox and SearchBox.Visible then
                                local sAbs = SearchBox.AbsolutePosition
                                local sSz = SearchBox.AbsoluteSize
                                inSearch = pos.X >= sAbs.X and pos.X <= sAbs.X+sSz.X and pos.Y >= sAbs.Y and pos.Y <= sAbs.Y+sSz.Y
                            end
                            if not inHeader and not inList and not inSearch then CloseDropdown() end
                        end)
                    end
                end)

                function Dropdown:SetValues(v)
                    if v then
                        values = v
                    else
                        values = Dropdown.Values or values
                    end
                    Dropdown.Values = values
                    BuildOptions(searchFilter)
                end
                function Dropdown:SetValue(v) selected=v SelectedLabel.Text=tostring(v) Dropdown.Value=v callback(v) if dropOnChanged then pcall(dropOnChanged, v) end BuildOptions(searchFilter) RunDependencyChecks() end
                function Dropdown:GetValue()
                    if multi then local r={} for k,v in pairs(multiSelected) do if v then table.insert(r,k) end end return r end
                    return selected
                end
                Dropdown.Value = selected
                Dropdown.Values = values
                function Dropdown:OnChanged(fn) dropOnChanged = fn end

                if id then
                    HollowLib.Flags[id] = Dropdown
                    if env.Options then env.Options[id] = Dropdown end
                end
                AddDependencySupport(Dropdown, Container)
                return Dropdown
            end

            -- AddLabel
            function Group:AddLabel(text, richText)
                local Label = {}
                local LabelFrame = MakeFrame(ItemContainer, UDim2.new(1,0,0,16), nil, Theme.ItemBG)
                LabelFrame.BackgroundTransparency = 1
                MakePadding(LabelFrame, 0, 0, 4, 4)
                local LabelText = MakeLabel(LabelFrame, text, 10, Theme.TextDim, Enum.Font.Gotham)
                LabelText.Size = UDim2.new(1,0,1,0) LabelText.TextYAlignment = Enum.TextYAlignment.Center
                LabelText.RichText = richText or false LabelText.TextWrapped = true

                function Label:AddKeyPicker(pid, pcfg) pcfg = pcfg or {} return Group:AddKeybindPicker(pid, pcfg) end
                function Label:AddColorPicker(pid, pcfg) return Group:AddColorPicker(pid, pcfg or {}) end
                function Label:SetText(t) LabelText.Text = t end
                Label.Text = LabelText

                AddDependencySupport(Label, LabelFrame)
                return Label
            end

            -- AddDivider
            function Group:AddDivider()
                local Div = MakeFrame(ItemContainer, UDim2.new(1,0,0,6), nil, Theme.GroupBG)
                Div.BackgroundTransparency = 1
                local Line = MakeFrame(Div, UDim2.new(1,-14,0,1), UDim2.new(0,7,0.5,0), Theme.Border)
                MakeCorner(Line, 1)
                return Div
            end

            -- AddColorPicker
            function Group:AddColorPicker(id, cfg)
                local ColorPicker = {}
                local color = cfg.Default or Color3.fromRGB(255,255,255)
                local callback = cfg.Callback or function() end
                local pickerOpen = false

                local Container = MakeFrame(ItemContainer, UDim2.new(1,0,0,24), nil, Theme.ItemBG)
                Container.BackgroundTransparency = 1
                MakePadding(Container, 0, 0, 4, 4)

                local PickerLabel = MakeLabel(Container, cfg.Title or id, 11, Theme.TextDim, Enum.Font.Gotham)
                PickerLabel.Size = UDim2.new(1,-36,1,0) PickerLabel.TextYAlignment = Enum.TextYAlignment.Center

                local ColorBtn = MakeButton(Container, UDim2.new(0,22,0,12), UDim2.new(1,-24,0.5,-6), color)
                MakeCorner(ColorBtn, 3) MakeStroke(ColorBtn, Theme.BorderBright, 1)

                local popupW, popupH = 195, 232
                local PickerPopup = MakeFrame(ScreenGui, UDim2.new(0,popupW,0,popupH), UDim2.new(0,0,0,0), Theme.Background)
                PickerPopup.Visible = false PickerPopup.ZIndex = 100
                PickerPopup.BackgroundTransparency = 0.05
                MakeCorner(PickerPopup, Radius.Group) MakeStroke(PickerPopup, Theme.BorderBright, 1)

                local PickerBar = MakeFrame(PickerPopup, UDim2.new(1,0,0,24), nil, Theme.GroupHeader)
                PickerBar.ZIndex = 101 PickerBar.BackgroundTransparency = 0.5
                MakeCorner(PickerBar, Radius.Group)
                local PickerBarFill = MakeFrame(PickerBar, UDim2.new(1,0,0.5,0), UDim2.new(0,0,0.5,0), Theme.GroupHeader)
                PickerBarFill.ZIndex = 101 PickerBarFill.BackgroundTransparency = 0.5

                local PickerTitle = MakeLabel(PickerBar, cfg.Title or "Color Picker", 11, Theme.Text, Enum.Font.GothamBold)
                PickerTitle.Size = UDim2.new(1,-12,1,0) PickerTitle.Position = UDim2.new(0,8,0,0)
                PickerTitle.ZIndex = 102 PickerTitle.TextYAlignment = Enum.TextYAlignment.Center

                MakeDraggable(PickerBar, PickerPopup)

                local svSize = 135
                local SVFrame = MakeFrame(PickerPopup, UDim2.new(0,svSize,0,svSize), UDim2.new(0,10,0,32), Color3.fromHSV(0,1,1))
                SVFrame.ZIndex = 101
                MakeCorner(SVFrame, 6) SVFrame.ClipsDescendants = true

                local WhiteOverlay = Instance.new("Frame")
                WhiteOverlay.Size = UDim2.new(1,0,1,0)
                WhiteOverlay.BackgroundColor3 = Color3.new(1,1,1)
                WhiteOverlay.BorderSizePixel = 0
                WhiteOverlay.ZIndex = 102
                WhiteOverlay.Parent = SVFrame
                local wg = Instance.new("UIGradient")
                wg.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1)
                })
                wg.Parent = WhiteOverlay

                local BlackOverlay = Instance.new("Frame")
                BlackOverlay.Size = UDim2.new(1,0,1,0)
                BlackOverlay.BackgroundColor3 = Color3.new(0,0,0)
                BlackOverlay.BorderSizePixel = 0
                BlackOverlay.ZIndex = 103
                BlackOverlay.Parent = SVFrame
                local bg = Instance.new("UIGradient")
                bg.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(1, 0)
                })
                bg.Rotation = 90
                bg.Parent = BlackOverlay

                local SVCursor = MakeFrame(SVFrame, UDim2.new(0,10,0,10), UDim2.new(0,0,0,0), Color3.new(1,1,1))
                SVCursor.ZIndex = 105
                MakeCorner(SVCursor, 5) MakeStroke(SVCursor, Color3.new(0,0,0), 2)

                local SVBtn = MakeButton(SVFrame, UDim2.new(1,0,1,0), nil, Theme.Background)
                SVBtn.BackgroundTransparency = 1 SVBtn.ZIndex = 104

                local HueBar = MakeFrame(PickerPopup, UDim2.new(0,18,0,svSize), UDim2.new(0,svSize+14,0,32), Color3.new(1,1,1))
                HueBar.ZIndex = 101
                MakeCorner(HueBar, 4) HueBar.ClipsDescendants = true

                local HueGrad = Instance.new("UIGradient")
                HueGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromHSV(0,1,1)),
                    ColorSequenceKeypoint.new(0.167, Color3.fromHSV(0.167,1,1)),
                    ColorSequenceKeypoint.new(0.333, Color3.fromHSV(0.333,1,1)),
                    ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5,1,1)),
                    ColorSequenceKeypoint.new(0.667, Color3.fromHSV(0.667,1,1)),
                    ColorSequenceKeypoint.new(0.833, Color3.fromHSV(0.833,1,1)),
                    ColorSequenceKeypoint.new(1, Color3.fromHSV(0.999,1,1))
                })
                HueGrad.Rotation = 90
                HueGrad.Parent = HueBar

                local HueCursor = MakeFrame(HueBar, UDim2.new(1,4,0,4), UDim2.new(0,-2,0,0), Color3.new(1,1,1))
                HueCursor.ZIndex = 106
                MakeCorner(HueCursor, 2) MakeStroke(HueCursor, Color3.new(0,0,0), 1)

                local HueBtn = MakeButton(HueBar, UDim2.new(1,0,1,0), nil, Theme.Background)
                HueBtn.BackgroundTransparency = 1 HueBtn.ZIndex = 105

                local HexRow = MakeFrame(PickerPopup, UDim2.new(0,popupW-20,0,20), UDim2.new(0,10,0,svSize+36), Theme.DropBG)
                HexRow.ZIndex = 101
                MakeCorner(HexRow, 4) MakeStroke(HexRow, Theme.Border, 1)

                local HexLabel = MakeLabel(HexRow, "#ffffff", 9, Theme.Text, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
                HexLabel.Size = UDim2.new(0.45,0,1,0) HexLabel.ZIndex = 102
                HexLabel.TextYAlignment = Enum.TextYAlignment.Center

                local RGBLabel = MakeLabel(HexRow, "255, 255, 255", 9, Theme.TextDim, Enum.Font.Gotham, Enum.TextXAlignment.Center)
                RGBLabel.Size = UDim2.new(0.55,0,1,0) RGBLabel.Position = UDim2.new(0.45,0,0,0)
                RGBLabel.ZIndex = 102 RGBLabel.TextYAlignment = Enum.TextYAlignment.Center

                local PreviewSwatch = MakeFrame(PickerPopup, UDim2.new(0,popupW-20,0,12), UDim2.new(0,10,0,svSize+60), color)
                PreviewSwatch.ZIndex = 101
                MakeCorner(PreviewSwatch, 4) MakeStroke(PreviewSwatch, Theme.Border, 1)

                local hue, sat, val = Color3.toHSV(color)

                local function UpdateColor()
                    color = Color3.fromHSV(hue, sat, val)
                    ColorBtn.BackgroundColor3 = color
                    SVFrame.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                    SVCursor.Position = UDim2.new(sat, -5, (1 - val), -5)
                    HueCursor.Position = UDim2.new(0, -2, hue, -2)
                    PreviewSwatch.BackgroundColor3 = color
                    local r = math.floor(color.R * 255)
                    local g = math.floor(color.G * 255)
                    local b = math.floor(color.B * 255)
                    HexLabel.Text = string.format("#%02x%02x%02x", r, g, b)
                    RGBLabel.Text = r .. ", " .. g .. ", " .. b
                    callback(color)
                end

                local svDrag = false
                SVBtn.MouseButton1Down:Connect(function() svDrag = true end)
                UserInputService.InputChanged:Connect(function(input)
                    if svDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        sat = math.clamp((input.Position.X - SVFrame.AbsolutePosition.X) / SVFrame.AbsoluteSize.X, 0, 1)
                        val = 1 - math.clamp((input.Position.Y - SVFrame.AbsolutePosition.Y) / SVFrame.AbsoluteSize.Y, 0, 1)
                        UpdateColor()
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then svDrag = false end
                end)

                local hueDrag = false
                HueBtn.MouseButton1Down:Connect(function() hueDrag = true end)
                UserInputService.InputChanged:Connect(function(input)
                    if hueDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        hue = math.clamp((input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 0.999)
                        UpdateColor()
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then hueDrag = false end
                end)

                local function CloseColorPicker()
                    pickerOpen = false
                    PickerPopup.Visible = false
                end

                ColorBtn.MouseButton1Click:Connect(function()
                    pickerOpen = not pickerOpen PickerPopup.Visible = pickerOpen
                    if pickerOpen then
                        local ap = ColorBtn.AbsolutePosition
                        PickerPopup.Position = UDim2.new(0, ap.X - popupW - 10, 0, ap.Y - 40)
                    end
                end)

                UserInputService.InputBegan:Connect(function(input)
                    if not pickerOpen then return end
                    if svDrag or hueDrag then return end
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        task.defer(function()
                            local pos = input.Position
                            local pAbs = PickerPopup.AbsolutePosition
                            local pSz = PickerPopup.AbsoluteSize
                            local bAbs = ColorBtn.AbsolutePosition
                            local bSz = ColorBtn.AbsoluteSize
                            local inPopup = pos.X >= pAbs.X and pos.X <= pAbs.X+pSz.X and pos.Y >= pAbs.Y and pos.Y <= pAbs.Y+pSz.Y
                            local inBtn = pos.X >= bAbs.X and pos.X <= bAbs.X+bSz.X and pos.Y >= bAbs.Y and pos.Y <= bAbs.Y+bSz.Y
                            if not inPopup and not inBtn then CloseColorPicker() end
                        end)
                    end
                end)

                UpdateColor()

                function ColorPicker:SetValue(c) color = c hue, sat, val = Color3.toHSV(c) UpdateColor() end
                function ColorPicker:GetValue() return color end

                ColorPicker.Value = color
                if id then
                    HollowLib.Flags[id] = ColorPicker
                    if env.Options then env.Options[id] = ColorPicker end
                end
                AddDependencySupport(ColorPicker, Container)
                return ColorPicker
            end

            -- AddKeybindPicker
            function Group:AddKeybindPicker(id, cfg)
                cfg = cfg or {}
                local KB = {}
                local key = cfg.Default
                if not key or key == '' or type(key) == 'string' then
                    if type(key) == 'string' and key ~= '' then
                        pcall(function() key = Enum.KeyCode[key] end)
                    end
                    if not key or type(key) ~= 'userdata' then
                        key = Enum.KeyCode.Unknown
                    end
                end
                local callback = cfg.Callback or function() end
                local listening = false
                local syncToggle = cfg.SyncToggleState or false
                local mode = cfg.Mode or 'Toggle'
                local noUI = cfg.NoUI or false

                local Row = MakeFrame(ItemContainer, UDim2.new(1,0,0,26), nil, Theme.ItemBG)
                Row.BackgroundTransparency = 1
                if noUI then Row.Visible = false Row.Size = UDim2.new(0,0,0,0) end
                MakeCorner(Row, Radius.Item) MakePadding(Row, 0, 0, 4, 4)

                local KBLabel = MakeLabel(Row, cfg.Text or id, 11, Theme.TextDim, Enum.Font.Gotham)
                KBLabel.Size = UDim2.new(1,-64,1,0) KBLabel.TextYAlignment = Enum.TextYAlignment.Center

                local KBBtn = MakeButton(Row, UDim2.new(0,58,0,16), UDim2.new(1,-60,0.5,-8), Theme.DropBG)
                KBBtn.BackgroundTransparency = 1
                MakeCorner(KBBtn, Radius.Small) MakeStroke(KBBtn, Theme.Border, 1)

                local keyName = "None"
                pcall(function() keyName = key.Name end)
                local KBText = MakeLabel(KBBtn, keyName, 9, Theme.Accent, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
                KBText.Size = UDim2.new(1,0,1,0) KBText.TextYAlignment = Enum.TextYAlignment.Center

                KBBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true KBText.Text = "..." KBText.TextColor3 = Theme.Text
                    Tween(KBBtn, {BackgroundColor3=Theme.AccentDark}, 0.15)
                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input, gpe)
                        if input.KeyCode ~= Enum.KeyCode.Unknown then
                            if input.KeyCode == Enum.KeyCode.Escape then
                                KBText.Text = tostring(key.Name) KBText.TextColor3 = Theme.Accent
                                Tween(KBBtn, {BackgroundColor3=Theme.DropBG}, 0.15)
                                listening = false conn:Disconnect() return
                            end
                            if IsKeyUsed(input.KeyCode) and input.KeyCode ~= key then
                                Library:Notify("Key already in use!", 2)
                                return
                            end
                            if key ~= Enum.KeyCode.Unknown then
                                _usedKeys[key] = math.max(0, (_usedKeys[key] or 0) - 1)
                            end
                            key = input.KeyCode
                            _usedKeys[key] = (_usedKeys[key] or 0) + 1
                            KBText.Text = tostring(key.Name) KBText.TextColor3 = Theme.Accent
                            Tween(KBBtn, {BackgroundColor3=Theme.DropBG}, 0.15)
                            listening = false callback(key)
                            if cfg.IsHideKey then
                                hideKey = key Window:Notify("Hide key: "..tostring(key.Name), 2)
                            end
                            KB.Value = key
                            conn:Disconnect()
                            RunDependencyChecks()
                        end
                    end)
                end)

                KBBtn.MouseEnter:Connect(function() if not listening then Tween(KBBtn,{BackgroundColor3=Theme.GroupHeader},0.1) end end)
                KBBtn.MouseLeave:Connect(function() if not listening then Tween(KBBtn,{BackgroundColor3=Theme.DropBG},0.1) end end)

                if syncToggle and id then
                    RegisterKeybind({
                        id = id,
                        parentToggle = cfg._parentToggle,
                        getKey = function() return key end,
                        isListening = function() return listening end,
                        mode = mode,
                    })
                end

                function KB:SetValue(k)
                    if key ~= Enum.KeyCode.Unknown then _usedKeys[key] = math.max(0, (_usedKeys[key] or 0) - 1) end
                    key = k
                    if key ~= Enum.KeyCode.Unknown then _usedKeys[key] = (_usedKeys[key] or 0) + 1 end
                    KBText.Text = tostring(k.Name)
                    if cfg.IsHideKey then hideKey = k end
                    KB.Value = k
                end
                function KB:GetValue() return key end

                KB.Value = key
                if id then
                    HollowLib.Flags[id] = KB
                    if env.Options then env.Options[id] = KB end
                end
                AddDependencySupport(KB, Row)
                return KB
            end

            -- AddInput
            function Group:AddInput(id, cfg)
                local Input = {}
                local value = cfg.Default or ""
                local callback = cfg.Callback or function() end
                local placeholder = cfg.Placeholder or "Type here..."

                local Row = MakeFrame(ItemContainer, UDim2.new(1,0,0,26), nil, Theme.ItemBG)
                Row.BackgroundTransparency = 1
                MakePadding(Row, 0, 0, 4, 4)

                local InputLabel = MakeLabel(Row, cfg.Text or id, 11, Theme.TextDim, Enum.Font.Gotham)
                InputLabel.Size = UDim2.new(0.4,0,1,0) InputLabel.TextYAlignment = Enum.TextYAlignment.Center

                local InputBox = Instance.new("TextBox")
                InputBox.Size = UDim2.new(0.6,-2,0,16)
                InputBox.Position = UDim2.new(0.4,2,0.5,-8)
                InputBox.BackgroundColor3 = Theme.SliderBG
                InputBox.BackgroundTransparency = 0.3
                InputBox.BorderSizePixel = 0
                InputBox.Text = value
                InputBox.PlaceholderText = placeholder
                InputBox.PlaceholderColor3 = Theme.TextDisabled
                InputBox.TextColor3 = Theme.Text
                InputBox.Font = Enum.Font.GothamMedium
                InputBox.TextSize = 10
                InputBox.ClearTextOnFocus = false
                InputBox.Parent = Row
                MakeCorner(InputBox, 4) MakeStroke(InputBox, Theme.Border, 1)

                local finished = cfg.Finished
                if finished == nil then finished = true end

                InputBox.FocusLost:Connect(function(enter)
                    value = InputBox.Text
                    Input.Value = value
                    callback(value, enter)
                end)

                InputBox:GetPropertyChangedSignal("Text"):Connect(function()
                    value = InputBox.Text
                    Input.Value = value
                    if not finished then callback(value, false) end
                    if Input._onChanged then Input._onChanged() end
                    RunDependencyChecks()
                end)

                InputBox.Focused:Connect(function()
                    Tween(InputBox, {BackgroundTransparency=0.1}, 0.15)
                end)
                InputBox.FocusLost:Connect(function()
                    Tween(InputBox, {BackgroundTransparency=0.3}, 0.15)
                end)

                function Input:SetValue(v) value = v InputBox.Text = v Input.Value = v end
                function Input:GetValue() return value end
                function Input:OnChanged(fn) Input._onChanged = fn end

                Input.Value = value
                if id then
                    HollowLib.Flags[id] = Input
                    if env.Options then env.Options[id] = Input end
                end
                AddDependencySupport(Input, Row)
                return Input
            end

            -- AddSearchBar
            function Group:AddSearchBar(cfg)
                local SearchBar = {}
                local callback = cfg.Callback or function() end
                local value = ""

                local Row = MakeFrame(ItemContainer, UDim2.new(1,0,0,26), nil, Theme.ItemBG)
                Row.BackgroundTransparency = 1
                MakePadding(Row, 0, 0, 4, 4)

                local SearchIcon = MakeLabel(Row, "?", 11, Theme.TextDisabled, Enum.Font.GothamBold)
                SearchIcon.Size = UDim2.new(0,14,1,0)
                SearchIcon.TextXAlignment = Enum.TextXAlignment.Center
                SearchIcon.TextYAlignment = Enum.TextYAlignment.Center

                local SearchInput = Instance.new("TextBox")
                SearchInput.Size = UDim2.new(1,-18,0,16)
                SearchInput.Position = UDim2.new(0,16,0.5,-8)
                SearchInput.BackgroundColor3 = Theme.SliderBG
                SearchInput.BackgroundTransparency = 0.3
                SearchInput.BorderSizePixel = 0
                SearchInput.Text = ""
                SearchInput.PlaceholderText = cfg.Placeholder or "type to search..."
                SearchInput.PlaceholderColor3 = Theme.TextDisabled
                SearchInput.TextColor3 = Theme.Text
                SearchInput.Font = Enum.Font.Gotham
                SearchInput.TextSize = 10
                SearchInput.ClearTextOnFocus = false
                SearchInput.Parent = Row
                MakeCorner(SearchInput, 4) MakeStroke(SearchInput, Theme.Border, 1)

                SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
                    value = SearchInput.Text
                    callback(value)
                end)

                SearchInput.Focused:Connect(function()
                    Tween(SearchInput, {BackgroundTransparency=0.1}, 0.15)
                    Tween(SearchIcon, {TextColor3=Theme.Accent}, 0.15)
                end)
                SearchInput.FocusLost:Connect(function()
                    Tween(SearchInput, {BackgroundTransparency=0.3}, 0.15)
                    Tween(SearchIcon, {TextColor3=Theme.TextDisabled}, 0.15)
                end)

                function SearchBar:SetValue(v) value = v SearchInput.Text = v end
                function SearchBar:GetValue() return value end
                function SearchBar:Clear() value = "" SearchInput.Text = "" end

                if cfg.Flag then HollowLib.Flags[cfg.Flag] = SearchBar if env.Options then env.Options[cfg.Flag] = SearchBar end end
                return SearchBar
            end

            Group.AddKeyPicker = Group.AddKeybindPicker

            local SafeReturn = {Value = nil}
            function SafeReturn:SetValue() end
            function SafeReturn:SetValues() end
            function SafeReturn:GetValue() return nil end
            function SafeReturn:OnChanged() end
            function SafeReturn:AddColorPicker() return SafeReturn end
            function SafeReturn:AddKeyPicker() return SafeReturn end
            function SafeReturn:SetText() end

            for methodName, method in pairs(Group) do
                if type(method) == "function" and methodName:sub(1,3) == "Add" then
                    local old = method
                    Group[methodName] = function(self, ...)
                        local ok, result = pcall(old, self, ...)
                        if ok then return result end
                        return SafeReturn
                    end
                end
            end

            Group._container = ItemContainer
            function Group:_setContainer(c) ItemContainer = c end
            function Group:_getContainer() return ItemContainer end

            return Group
        end

        function Tab:AddLeftGroupbox(name) return AddGroupInternal(name, LeftCol) end
        function Tab:AddRightGroupbox(name) return AddGroupInternal(name, RightCol) end
        function Tab:AddGroupbox(name) return AddGroupInternal(name, LeftCol) end

        -- TabBox
        local function CreateTabBox(col)
            local TBFrame = MakeFrame(col, UDim2.new(1,0,0,28), nil, Theme.GroupBG)
            pcall(function() TBFrame.AutomaticSize = Enum.AutomaticSize.Y end)
            TBFrame.ClipsDescendants = true
            MakeCorner(TBFrame, Radius.Group)
            MakeStroke(TBFrame, Theme.Border, 1)

            local TBHeader = MakeFrame(TBFrame, UDim2.new(1,0,0,28), nil, Theme.GroupBG)
            TBHeader.BackgroundTransparency = 0.5 TBHeader.ZIndex = 2
            local hl = Instance.new("UIListLayout")
            hl.FillDirection = Enum.FillDirection.Horizontal
            hl.Padding = UDim.new(0,0) hl.Parent = TBHeader

            local tbTabs = {}
            local TBObj = {}

            function TBObj:AddTab(tabName)
                local idx = #tbTabs + 1

                local tbBtn = Instance.new("TextButton")
                tbBtn.BackgroundTransparency = 1 tbBtn.Text = tabName
                tbBtn.Font = Enum.Font.GothamMedium tbBtn.TextSize = 11
                tbBtn.TextColor3 = idx == 1 and Theme.Text or Theme.TextDim
                tbBtn.BorderSizePixel = 0 tbBtn.Parent = TBHeader

                local tbLine = MakeFrame(tbBtn, UDim2.new(0.5,0,0,2), UDim2.new(0.25,0,1,-2), Theme.Accent)
                MakeCorner(tbLine, 1)
                tbLine.BackgroundTransparency = idx == 1 and 0 or 1

                local tbContent = MakeFrame(TBFrame, UDim2.new(1,0,0,0), UDim2.new(0,0,0,28), Theme.GroupBG)
                tbContent.BackgroundTransparency = 1
                pcall(function() tbContent.AutomaticSize = Enum.AutomaticSize.Y end)
                tbContent.Visible = (idx == 1)
                MakePadding(tbContent, 8, 10, 8, 8)
                MakeList(tbContent, 6)

                table.insert(tbTabs, {btn=tbBtn, content=tbContent, line=tbLine})
                for _, t in ipairs(tbTabs) do t.btn.Size = UDim2.new(1/#tbTabs, 0, 1, 0) end

                tbBtn.MouseButton1Click:Connect(function()
                    for _, t in ipairs(tbTabs) do
                        t.content.Visible = false
                        Tween(t.btn, {TextColor3=Theme.TextDim}, 0.15)
                        Tween(t.line, {BackgroundTransparency=1}, 0.15)
                    end
                    tbContent.Visible = true
                    Tween(tbBtn, {TextColor3=Theme.Text}, 0.15)
                    Tween(tbLine, {BackgroundTransparency=0}, 0.15)
                end)

                local tabGroup = AddGroupInternal(tabName, col, tbContent)
                return tabGroup
            end

            return TBObj
        end

        function Tab:AddLeftTabbox() return CreateTabBox(LeftCol) end
        function Tab:AddRightTabbox() return CreateTabBox(RightCol) end

        return Tab
    end

    -- ===== Window Methods =====
    function Window:Notify(text, duration)
        local title, desc
        if type(text) == "table" then
            title = text.Title or "Notice"
            desc = text.Description or ""
        else
            title = "Notice"
            desc = tostring(text)
        end
        PushNotification(title, desc, duration)
    end

    function Window:SetWatermark(text) WMName.Text = text end
    function Window:SetWatermarkVisibility(visible) Watermark.Visible = visible end
    function Window:SetHideKey(key) hideKey = key end
    function Window:SetDisplayName(name) PlayerName.Text = name end
    function Window:SetUsername(name) end
    function Window:SetLogo(textureId) if LogoImg then LogoImg.Image = "rbxassetid://"..tostring(textureId) end end
    function Window:SetBackground(textureId, transparency)
        local id = tostring(textureId)
        if tonumber(id) then id = "rbxassetid://" .. id end
        BGImage.Image = id
        BGImage.ImageTransparency = transparency or 0.65
    end
    function Window:SetAccent(color)
        Theme.Accent = color
        Theme.AccentDark = Color3.fromRGB(math.floor(color.R*180), math.floor(color.G*180), math.floor(color.B*180))
        Theme.ToggleOn = color
        Theme.SliderFill = color
        Theme.TabActive = color
        WMBar.BackgroundColor3 = color
    end

    function Window:Unload()
        ScreenGui:Destroy()
        if getgenv()._HollowUnload then getgenv()._HollowUnload() end
    end
    function Window:OnUnload(callback) getgenv()._HollowUnload = callback end

    return Window
end

-- ===== LinoriaLib Compatibility =====
getgenv().Options = env.Options
getgenv().Toggles = env.Toggles
Options = env.Options
Toggles = env.Toggles

local _createdWindow = nil
local _unloadCallbacks = {}

local Library = setmetatable({}, {
    __index = function(t, k)
        if k == "Options" then return Options end
        if k == "Toggles" then return Toggles end
        if k == "Flags" then return HollowLib.Flags end
        return HollowLib[k]
    end,
    __newindex = function(t, k, v)
        if k == "ToggleKeybind" and _createdWindow and v then
            pcall(function() _createdWindow:SetHideKey(v) end)
        end
        if k == "OnUnload" and type(v) == "function" then
            table.insert(_unloadCallbacks, v)
        end
        rawset(t, k, v)
    end
})

function Library:CreateWindow(config)
    local win = HollowLib:CreateWindow(config)
    _createdWindow = win
    return win
end

function Library:Notify(text, duration)
    if _createdWindow then _createdWindow:Notify(text, duration) end
end

function Library:SetWatermark(text)
    if _createdWindow then _createdWindow:SetWatermark(text) end
end

function Library:SetWatermarkVisibility(visible)
    if _createdWindow then _createdWindow:SetWatermarkVisibility(visible) end
end

function Library:Unload()
    for _, fn in ipairs(_unloadCallbacks) do pcall(fn) end
    if _createdWindow then _createdWindow:Unload() end
end

function Library:OnUnload(callback)
    if type(callback) == "function" then
        table.insert(_unloadCallbacks, callback)
    end
    if _createdWindow then _createdWindow:OnUnload(callback) end
end

return Library
