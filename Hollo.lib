Library.Watermark = function(self, Params)
    local Watermark = {}
    local Items = {}
    Items["Watermark"] = Inst:Create("Frame", {
        Parent = Library.Holder.Instance,
        Name = "\0",
        AnchorPoint = Vector2New(0.5,0),
        Position = UDim2New(0.5,0,0,42),
        Size = UDim2New(0,0,0,25),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.X,
    })
    Items["Watermark"]:AddToTheme({ BackgroundColor3 = "Background" })
    Items["Watermark"]:MakeDraggable()
    Inst:Create("UIStroke", { Parent = Items["Watermark"].Instance, Color = Theme.Outline, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
    Items["Text"] = Inst:Create("TextLabel", {
        Parent = Items["Watermark"].Instance,
        Font = Library.Font,
        TextSize = 14,
        Text = Params.Name or "Hollow",
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2New(0,0,0,15),
        Position = UDim2New(0,8,0.5,0),
        AutomaticSize = Enum.AutomaticSize.X,
    })
    function Watermark:SetText(text)
        Items["Text"].Instance.Text = text
    end
    function Watermark:SetVisibility(bool)
        Items["Watermark"].Instance.Visible = bool
    end
    return Watermark
end

